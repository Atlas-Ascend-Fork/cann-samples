#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "../common/host_utils/host_utils.h"

#ifndef KK
#define KK 4096
#endif

constexpr uint32_t M = 4096;
constexpr uint32_t N = 4096;
constexpr uint32_t K = KK;

constexpr uint32_t MB = 128;                 // C tile rows
constexpr uint32_t NB = 128;                 // C tile cols
constexpr uint32_t KB = 32;                  // k-tile depth
static_assert(M % MB == 0 && N % NB == 0 && K % KB == 0, "tile sizes must divide M/N/K");

constexpr int WARMUP = (KK >= 1024) ? 1 : 5;
constexpr int ITERS = (KK >= 1024) ? 2 : 50;

__global__ __aicore__ __vector__ void matmul_tiled(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qAh;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qA;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qBh;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qB;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qC;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qOut;
    pipe.InitBuffer(qAh, 1, MB * KB * sizeof(half));
    pipe.InitBuffer(qA, 1, MB * KB * sizeof(float));
    pipe.InitBuffer(qBh, 1, KB * NB * sizeof(half));
    pipe.InitBuffer(qB, 1, KB * NB * sizeof(float));
    pipe.InitBuffer(qC, 1, MB * NB * sizeof(float));
    pipe.InitBuffer(qOut, 1, MB * NB * sizeof(half));

    AscendC::GlobalTensor<half> aGm;
    AscendC::GlobalTensor<half> bGm;
    AscendC::GlobalTensor<half> cGm;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a));
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b));
    cGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(c));

    // 2D tile copy parameters (units of 32B bursts)
    AscendC::DataCopyParams aParams{(uint16_t)MB, (uint16_t)(KB * 2 / 32), (uint16_t)((K - KB) * 2 / 32), 0};
    AscendC::DataCopyParams bParams{(uint16_t)KB, (uint16_t)(NB * 2 / 32), (uint16_t)((N - NB) * 2 / 32), 0};
    AscendC::DataCopyParams cParams{(uint16_t)MB, (uint16_t)(NB * 2 / 32), 0, (uint16_t)((N - NB) * 2 / 32)};

    for (uint32_t mt = 0; mt < M / MB; ++mt) {
        for (uint32_t nt = 0; nt < N / NB; ++nt) {
            AscendC::LocalTensor<float> cLocal = qC.AllocTensor<float>();
            AscendC::Duplicate(cLocal, 0.0f, MB * NB);
            for (uint32_t kt = 0; kt < K / KB; ++kt) {
                AscendC::LocalTensor<half> aHalf = qAh.AllocTensor<half>();
                AscendC::DataCopy(aHalf, aGm[mt * MB * K + kt * KB], aParams);
                qAh.EnQue(aHalf);
                aHalf = qAh.DeQue<half>();

                AscendC::LocalTensor<float> aLocal = qA.AllocTensor<float>();
                AscendC::Cast(aLocal, aHalf, AscendC::RoundMode::CAST_NONE, MB * KB);
                qA.EnQue(aLocal);
                aLocal = qA.DeQue<float>();

                AscendC::LocalTensor<half> bHalf = qBh.AllocTensor<half>();
                AscendC::DataCopy(bHalf, bGm[kt * KB * N + nt * NB], bParams);
                qBh.EnQue(bHalf);
                bHalf = qBh.DeQue<half>();

                AscendC::LocalTensor<float> bLocal = qB.AllocTensor<float>();
                AscendC::Cast(bLocal, bHalf, AscendC::RoundMode::CAST_NONE, KB * NB);
                qB.EnQue(bLocal);
                bLocal = qB.DeQue<float>();

                for (uint32_t m = 0; m < MB; ++m) {
                    AscendC::LocalTensor<float> cRow = cLocal[m * NB];
                    for (uint32_t k = 0; k < KB; ++k) {
                        AscendC::Axpy(cRow, bLocal[k * NB], aLocal.GetValue(m * KB + k), NB);
                    }
                }
                qAh.FreeTensor(aHalf);
                qA.FreeTensor(aLocal);
                qBh.FreeTensor(bHalf);
                qB.FreeTensor(bLocal);
            }
            AscendC::LocalTensor<half> outHalf = qOut.AllocTensor<half>();
            AscendC::Cast(outHalf, cLocal, AscendC::RoundMode::CAST_NONE, MB * NB);
            qOut.EnQue(outHalf);
            outHalf = qOut.DeQue<half>();
            AscendC::DataCopy(cGm[mt * MB * N + nt * NB], outHalf, cParams);
            qOut.FreeTensor(outHalf);
            qC.FreeTensor(cLocal);
        }
    }
}

int32_t main()
{
    try {
        CHECK_COND(mm_tut::Fp16SelfTest(), "fp16 conversion self-test failed");


        std::vector<uint16_t> hostA(M * K);
        std::vector<uint16_t> hostB(K * N);
        mm_tut::MakeUniformInput(hostA);
        mm_tut::MakeUniformInput(hostB);

        int32_t deviceId = 0;
        aclrtStream stream = nullptr;
        CHECK_COND(aclInit(nullptr) == ACL_SUCCESS, "aclInit failed.");
        CHECK_COND(aclrtSetDevice(deviceId) == ACL_SUCCESS, "aclrtSetDevice failed.");
        CHECK_COND(aclrtCreateStream(&stream) == ACL_SUCCESS, "aclrtCreateStream failed.");

        size_t szA = M * K * sizeof(uint16_t);
        size_t szB = K * N * sizeof(uint16_t);
        size_t szC = M * N * sizeof(uint16_t);
        uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr;
        CHECK_COND(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dA failed.");
        CHECK_COND(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dB failed.");
        CHECK_COND(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dC failed.");

        CHECK_COND(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS,
                   "aclrtMemcpy dA failed.");
        CHECK_COND(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS,
                   "aclrtMemcpy dB failed.");

        std::vector<uint16_t> outHost(M * N, 0);
        auto runMm = [&]() { matmul_tiled<<<1, nullptr, stream>>>(dA, dB, dC); };
        std::cout << "shape: M=N=" << M << ", K=" << K << " (single AIV, fp16 in / fp16 out)" << std::endl;

        runMm();
        CHECK_COND(aclrtSynchronizeStream(stream) == ACL_SUCCESS, "aclrtSynchronizeStream failed.");
        CHECK_COND(aclrtMemcpy(outHost.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS,
                   "aclrtMemcpy outC failed.");
        double maxErr1 = 0.0;
        uint32_t bad1 = mm_tut::GoldenSpotCheck(hostA, hostB, outHost, M, N, K, &maxErr1);
        std::cout << "spot-check vs double golden: max abs err " << maxErr1 << ", bad " << bad1 << "/1024"
                  << (bad1 == 0 ? " [PASS]" : " [FAILED]") << std::endl;

        double msMm = 0.0;
        CHECK_COND(mm_tut::TimedRun(runMm, WARMUP, ITERS, stream, &msMm),
                   "aclrtSynchronizeStream failed during timing.");

        CHECK_COND(aclrtMemcpy(outHost.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS,
                   "aclrtMemcpy outC(recheck) failed.");
        double maxErr2 = 0.0;
        uint32_t bad2 = mm_tut::GoldenSpotCheck(hostA, hostB, outHost, M, N, K, &maxErr2);
        std::cout << "spot-check vs double golden (post-timing): max abs err " << maxErr2 << ", bad " << bad2 << "/1024"
                  << (bad2 == 0 ? " [PASS]" : " [FAILED]") << std::endl;
        std::cout << "matmul: " << msMm << " ms/iter" << std::endl;;

        CHECK_COND(aclrtFree(dA) == ACL_SUCCESS, "aclrtFree dA failed.");
        CHECK_COND(aclrtFree(dB) == ACL_SUCCESS, "aclrtFree dB failed.");
        CHECK_COND(aclrtFree(dC) == ACL_SUCCESS, "aclrtFree dC failed.");
        CHECK_COND(aclrtDestroyStream(stream) == ACL_SUCCESS, "aclrtDestroyStream failed.");
        CHECK_COND(aclrtResetDevice(deviceId) == ACL_SUCCESS, "aclrtResetDevice failed.");
        CHECK_COND(aclFinalize() == ACL_SUCCESS, "aclFinalize failed.");
        return (bad1 == 0 && bad2 == 0) ? 0 : 1;
    } catch (const std::exception& e) {
        std::cerr << e.what() << std::endl;
        return 1;
    }
}
