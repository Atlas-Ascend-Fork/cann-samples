#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "../common/host_utils/host_utils.h"

constexpr uint32_t M = 4096;
constexpr uint32_t N = 4096;
constexpr uint32_t K = 4096;
constexpr uint32_t TILE = 256;
#ifndef BASE_M_FIX
#define BASE_M_FIX 128
#define BASE_N_FIX 256
#define BASE_K_FIX 64
#endif
constexpr int WARMUP = 5;
constexpr int ITERS = 20;

// ---------------- cube matmul with snake-window tile order ----------------
__global__ __cube__ void mm_cube_snake(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* workspace,
    AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<half> cGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(c), tiling.M * tiling.N);
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>>
        matmulObj;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);
    matmulObj.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    matmulObj.SetSingleShape(TILE, TILE, tiling.Ka);
    uint32_t core = AscendC::GetBlockIdx();
    uint32_t pr = core / 4;   // 窗口内行位置
    uint32_t pc = core % 4;   // 窗口内列位置
    for (uint32_t w = 0; w < 16; ++w) {
        uint32_t wC = w / 4;                            // 窗口列（外层，慢变 -> B 板驻留）
        uint32_t wR = (wC % 2 == 0) ? (w % 4) : (3 - w % 4);  // 窗口行（蛇形 -> 边界 A 板复用）
        uint32_t r = wR * 4 + pr;
        uint32_t c = wC * 4 + pc;
        matmulObj.SetTensorA(aGlobal[static_cast<uint64_t>(r) * TILE * tiling.Ka], false);
        matmulObj.SetTensorB(bGlobal[static_cast<uint64_t>(c) * TILE], false);
        matmulObj.IterateAll(cGlobal[static_cast<uint64_t>(r) * TILE * tiling.N +
                                     static_cast<uint64_t>(c) * TILE]);
    }
    matmulObj.End();
}

static bool GenTiling(platform_ascendc::PlatformAscendC* plat, int aicNum, AscendC::tiling::TCubeTiling* t)
{
    matmul_tiling::MultiCoreMatmulTiling tilingApi(*plat);
    tilingApi.SetDim(aicNum);
    tilingApi.SetAType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetBType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16);
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.SetFixSplit(BASE_M_FIX, BASE_N_FIX, BASE_K_FIX);   // 正规 API 固定 base tile
    tilingApi.EnableBias(false);
    tilingApi.SetBufferSpace(-1, -1, -1);
    return tilingApi.GetTiling(*t) != -1;   // 失败时 *t 内容无效，调用方禁止使用
}

int32_t main()
{
    try {
        CHECK_COND(mm_tut::Fp16SelfTest(), "fp16 conversion self-test failed");

        auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
        CHECK_COND(plat != nullptr, "PlatformAscendCManager::GetInstance failed.");
        int aicNum = plat->GetCoreNumAic();
        while (aicNum > 1 && M % aicNum != 0) { --aicNum; }

        std::vector<uint16_t> hostA(M * K);
        std::vector<uint16_t> hostB(K * N);
        mm_tut::MakeUniformInput(hostA);
        mm_tut::MakeUniformInput(hostB);

        int32_t deviceId = 0;
        aclrtStream stream = nullptr;
        CHECK_COND(aclInit(nullptr) == ACL_SUCCESS, "aclInit failed.");
        CHECK_COND(aclrtSetDevice(deviceId) == ACL_SUCCESS, "aclrtSetDevice failed.");
        CHECK_COND(aclrtCreateStream(&stream) == ACL_SUCCESS, "aclrtCreateStream failed.");

        size_t szA = M * K * sizeof(uint16_t);
        size_t szB = K * N * sizeof(uint16_t);
        size_t szC = M * N * sizeof(uint16_t);
        size_t szWs = static_cast<size_t>(plat->GetLibApiWorkSpaceSize());
        uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr, *dWs = nullptr;
        CHECK_COND(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dA failed.");
        CHECK_COND(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dB failed.");
        CHECK_COND(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dC failed.");
        CHECK_COND(aclrtMalloc((void**)&dWs, szWs, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dWs failed.");
        CHECK_COND(aclrtMemset(dWs, szWs, 0, szWs) == ACL_SUCCESS, "aclrtMemset dWs failed.");

        CHECK_COND(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS,
                   "aclrtMemcpy dA failed.");
        CHECK_COND(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS,
                   "aclrtMemcpy dB failed.");
        // base tile 由 L0C 预算锁定为 128x256：fp32 累加块 128x256x4B = 128KB 已是整块 L0C。
        // 扩大 base tile 的三条路都验证失败（256x256 需 256KB 累加块，物理装不下）：
        //   SetSplitRange 空实现 / 手工覆盖派生字段结果错误 / SetFixSplit(256,256) 被 L0C 预算拒绝。
        AscendC::tiling::TCubeTiling tiling;
        CHECK_COND(GenTiling(plat, aicNum, &tiling), "MultiCoreMatmulTiling GetTiling failed.");
        std::cout << "snake tiling: usedCoreNum=" << tiling.usedCoreNum << " singleCoreM=" << tiling.singleCoreM
                  << " singleCoreN=" << tiling.singleCoreN << " base=" << tiling.baseM << "x" << tiling.baseN << "x"
                  << tiling.baseK << std::endl;

        std::vector<uint16_t> outHost(M * N, 0);
        auto runMm = [&]() { mm_cube_snake<<<tiling.usedCoreNum, 0, stream>>>(dA, dB, dC, dWs, tiling); };

        runMm();
        CHECK_COND(aclrtSynchronizeStream(stream) == ACL_SUCCESS, "aclrtSynchronizeStream failed.");
        CHECK_COND(aclrtMemcpy(outHost.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS,
                   "aclrtMemcpy outC failed.");
        double maxErr1 = 0.0;
        uint32_t bad1 = mm_tut::GoldenSpotCheck(hostA, hostB, outHost, M, N, K, &maxErr1);
        std::cout << "snake spot-check: max abs err " << maxErr1 << ", bad " << bad1 << "/1024"
                  << (bad1 == 0 ? " [PASS]" : " [FAILED]") << std::endl;

        double msMm = 0.0;
        CHECK_COND(mm_tut::TimedRun(runMm, WARMUP, ITERS, stream, &msMm),
                   "aclrtSynchronizeStream failed during timing.");

        CHECK_COND(aclrtMemcpy(outHost.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS,
                   "aclrtMemcpy outC(recheck) failed.");
        double maxErr2 = 0.0;
        uint32_t bad2 = mm_tut::GoldenSpotCheck(hostA, hostB, outHost, M, N, K, &maxErr2);
        std::cout << "snake spot-check (post-timing): max abs err " << maxErr2 << ", bad " << bad2 << "/1024"
                  << (bad2 == 0 ? " [PASS]" : " [FAILED]") << std::endl;
        std::cout << "snake matmul: " << msMm << " ms/iter  (" << (2.0 * M * N * K / (msMm * 1e9)) << " TFLOPS fp16)" << std::endl;;

        CHECK_COND(aclrtFree(dA) == ACL_SUCCESS, "aclrtFree dA failed.");
        CHECK_COND(aclrtFree(dB) == ACL_SUCCESS, "aclrtFree dB failed.");
        CHECK_COND(aclrtFree(dC) == ACL_SUCCESS, "aclrtFree dC failed.");
        CHECK_COND(aclrtFree(dWs) == ACL_SUCCESS, "aclrtFree dWs failed.");
        CHECK_COND(aclrtDestroyStream(stream) == ACL_SUCCESS, "aclrtDestroyStream failed.");
        CHECK_COND(aclrtResetDevice(deviceId) == ACL_SUCCESS, "aclrtResetDevice failed.");
        CHECK_COND(aclFinalize() == ACL_SUCCESS, "aclFinalize failed.");
        return (bad1 == 0 && bad2 == 0) ? 0 : 1;
    } catch (const std::exception& e) {
        std::cerr << e.what() << std::endl;
        return 1;
    }
}
