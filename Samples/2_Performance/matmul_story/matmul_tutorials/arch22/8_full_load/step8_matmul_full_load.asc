#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "../common/host_utils/host_utils.h"

constexpr uint32_t M = 32;
constexpr uint32_t N = 4096;
constexpr uint32_t K = 4096;
constexpr uint32_t TILE_N = 128;           // L0C tile: 32x128 fp32 = 16KB
constexpr uint32_t K_L1 = 128;             // L1 驻留的 K chunk
constexpr uint32_t K_L0 = 64;              // 每次 Mmad 的 K
constexpr uint32_t K_CHUNKS = K / K_L1;    // 32
constexpr uint32_t L0_STEPS = K_L1 / K_L0; // 2
constexpr uint32_t NT_PER_CORE = 2;        // 每核 2 个 N tile（16 核 x 2 x 128 = 4096）
constexpr int WARMUP = 5;
constexpr int ITERS = 20;

// ---------------- variant A: generic template (A re-swept per N-tile) ----------------
__global__ __cube__ void mm_stream(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<half> cGM;
    aGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a));
    bGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b));
    cGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(c));

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0aAlloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0bAlloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0cAlloc;
    // L1: A 双缓冲 2x8KB + B 双缓冲 2x32KB = 80KB
    AscendC::LocalTensor<half> a1[2] = {l1Alloc.Alloc<AscendC::TPosition::A1, half>(M * K_L1),
                                        l1Alloc.Alloc<AscendC::TPosition::A1, half>(M * K_L1)};
    AscendC::LocalTensor<half> b1[2] = {l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N),
                                        l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N)};
    AscendC::LocalTensor<half> a2[2] = {l0aAlloc.Alloc<AscendC::TPosition::A2, half>(M * K_L0),
                                        l0aAlloc.Alloc<AscendC::TPosition::A2, half>(M * K_L0)};
    AscendC::LocalTensor<half> b2[2] = {l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N),
                                        l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N)};
    AscendC::LocalTensor<float> c0 = l0cAlloc.Alloc<AscendC::TPosition::CO1, float>(M * TILE_N);

    const uint32_t core = AscendC::GetBlockIdx();

    // 预置反向旗，让首轮生产者 Wait 直接通过
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID3);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID4);

    for (uint32_t nt = 0; nt < NT_PER_CORE; ++nt) {
        const uint32_t n0 = core * (NT_PER_CORE * TILE_N) + nt * TILE_N;
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0); // 等 L0C 被 FIX 搬空
        for (uint32_t kc = 0; kc < K_CHUNKS; ++kc) {
            const uint32_t lb = kc & 1;
            const uint32_t kL1Off = kc * K_L1;
            const AscendC::TEventID evL1 = (lb == 0) ? EVENT_ID1 : EVENT_ID2;
            // ---- MTE2: GM -> L1（ND -> NZ）----
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(evL1);
            // A 条带 [32m x 128k] @ (0, kL1Off) —— 每个 N-tile 都要整条重扫
            AscendC::DataCopy(
                a1[lb], aGM[kL1Off],
                AscendC::Nd2NzParams{1, M, K_L1, 0, K, M, 1, 0});
            // B tile [128k x 128n] @ (kL1Off, n0)
            AscendC::DataCopy(
                b1[lb], bGM[static_cast<uint64_t>(kL1Off) * N + n0],
                AscendC::Nd2NzParams{1, K_L1, TILE_N, 0, N, K_L1, 1, 0});
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(evL1);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(evL1); // MTE1 等 MTE2
            for (uint32_t j = 0; j < L0_STEPS; ++j) {
                const uint32_t q = j & 1;
                const AscendC::TEventID evL0 = (q == 0) ? EVENT_ID3 : EVENT_ID4;
                // ---- MTE1: L1 -> L0（NZ -> Zz/Zn，按 16x16 分形块收集）----
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(evL0);
                for (uint32_t i = 0; i < M / 16; ++i) { // A: 2 个 m 条带 x 各 4 个 k 块
                    AscendC::LoadData(
                        a2[q][i * K_L0 * 16], a1[lb][(j * (K_L0 / 16) * (M / 16) + i) * 256],
                        AscendC::LoadData2DParams{0, K_L0 / 16, M / 16, 0, 0, false, 0});
                }
                for (uint32_t i = 0; i < K_L0 / 16; ++i) { // B: 4 个 k 条带 x 各 8 个 n 块
                    AscendC::LoadData(
                        b2[q][i * TILE_N * 16], b1[lb][(j * (K_L0 / 16) + i) * 256],
                        AscendC::LoadData2DParams{0, TILE_N / 16, K_L1 / 16, 0, 0, true, 0});
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(evL0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(evL0); // M 等 MTE1
                // ---- M: 32x128x64 累加进 L0C ----
                AscendC::Mmad(
                    c0, a2[q], b2[q],
                    AscendC::MmadParams{M, TILE_N, K_L0, 0, false, kc == 0 && j == 0});
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(evL0);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(evL1); // L1[lb] 读完，还给 MTE2
        }
        // ---- FIX: L0C -> GM（NZ -> ND，出栈 fp32→fp16）----
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::Fixpipe(
            cGM[static_cast<uint64_t>(0) * N + n0], c0,
            AscendC::FixpipeParamsV220{TILE_N, M, M, N, false, QuantMode_t::F322F16, 0, 1, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    }
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    // 排空环启动预置留下的未消费旗：旗状态跨 launch 残留，不排空会污染下一个 kernel
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID3);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID4);
}

// ---------------- variant B: full-load template (aL1 resident) ----------------
__global__ __cube__ void mm_fullload(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<half> cGM;
    aGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a));
    bGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b));
    cGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(c));

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0aAlloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0bAlloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0cAlloc;
    // L1: A 全载 [32 x 4096] fp16 = 256KB + B 双缓冲 2x32KB = 总 320KB <= 511.75KB
    AscendC::LocalTensor<half> a1full = l1Alloc.Alloc<AscendC::TPosition::A1, half>(M * K);
    AscendC::LocalTensor<half> b1[2] = {l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N),
                                        l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N)};
    AscendC::LocalTensor<half> a2[2] = {l0aAlloc.Alloc<AscendC::TPosition::A2, half>(M * K_L0),
                                        l0aAlloc.Alloc<AscendC::TPosition::A2, half>(M * K_L0)};
    AscendC::LocalTensor<half> b2[2] = {l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N),
                                        l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N)};
    AscendC::LocalTensor<float> c0 = l0cAlloc.Alloc<AscendC::TPosition::CO1, float>(M * TILE_N);

    const uint32_t core = AscendC::GetBlockIdx();

    // 预置反向旗，让首轮生产者 Wait 直接通过
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID3);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID4);

    // ---- 预取：A 一次性 Nd2Nz 全载进 L1（[32 x 4096] NZ = 256KB），此后常驻 ----
    AscendC::DataCopy(
        a1full, aGM[0],
        AscendC::Nd2NzParams{1, M, K, 0, K, M, 1, 0});
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5); // 预取完成，通知 MTE1

    for (uint32_t nt = 0; nt < NT_PER_CORE; ++nt) {
        const uint32_t n0 = core * (NT_PER_CORE * TILE_N) + nt * TILE_N;
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0); // 等 L0C 被 FIX 搬空
        for (uint32_t kc = 0; kc < K_CHUNKS; ++kc) {
            const uint32_t lb = kc & 1;
            const uint32_t kL1Off = kc * K_L1;
            const AscendC::TEventID evL1 = (lb == 0) ? EVENT_ID1 : EVENT_ID2;
            // ---- MTE2: GM -> L1（只流 B；A 已驻留，不再搬运）----
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(evL1);
            AscendC::DataCopy(
                b1[lb], bGM[static_cast<uint64_t>(kL1Off) * N + n0],
                AscendC::Nd2NzParams{1, K_L1, TILE_N, 0, N, K_L1, 1, 0});
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(evL1);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(evL1); // MTE1 等 MTE2
            for (uint32_t j = 0; j < L0_STEPS; ++j) {
                const uint32_t q = j & 1;
                const AscendC::TEventID evL0 = (q == 0) ? EVENT_ID3 : EVENT_ID4;
                if (nt == 0 && kc == 0 && j == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID5); // 首次读 A 前等预取落定
                }
                // A 窗口基（以 16 列为单位）：k1 = kc*(K_L1/16) + j*(K_L0/16)
                const uint32_t k1 = kc * (K_L1 / 16) + j * (K_L0 / 16);
                // ---- MTE1: L1 -> L0，A 在常驻缓冲内原地开窗 ----
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(evL0);
                for (uint32_t i = 0; i < M / 16; ++i) { // A: 2 个 m 条带 x 各 4 个 k 块
                    AscendC::LoadData(
                        a2[q][i * K_L0 * 16], a1full[(k1 * (M / 16) + i) * 256],
                        AscendC::LoadData2DParams{0, K_L0 / 16, M / 16, 0, 0, false, 0});
                }
                for (uint32_t i = 0; i < K_L0 / 16; ++i) { // B: 4 个 k 条带 x 各 8 个 n 块
                    AscendC::LoadData(
                        b2[q][i * TILE_N * 16], b1[lb][(j * (K_L0 / 16) + i) * 256],
                        AscendC::LoadData2DParams{0, TILE_N / 16, K_L1 / 16, 0, 0, true, 0});
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(evL0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(evL0); // M 等 MTE1
                // ---- M: 32x128x64 累加进 L0C ----
                AscendC::Mmad(
                    c0, a2[q], b2[q],
                    AscendC::MmadParams{M, TILE_N, K_L0, 0, false, kc == 0 && j == 0});
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(evL0);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(evL1); // L1[lb] 读完，还给 MTE2
        }
        // ---- FIX: L0C -> GM（NZ -> ND，出栈 fp32→fp16）----
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::Fixpipe(
            cGM[static_cast<uint64_t>(0) * N + n0], c0,
            AscendC::FixpipeParamsV220{TILE_N, M, M, N, false, QuantMode_t::F322F16, 0, 1, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    }
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    // 排空预置旗（ID5 已由首次用 A 前的 Wait 消费，1 set + 1 wait 平衡，无需排空）
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID3);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID4);
}

// ---------------- host ----------------
int32_t main()
{
    try {
        CHECK_COND(mm_tut::Fp16SelfTest(), "fp16 conversion self-test failed");

        int32_t deviceId = 0;
        aclrtStream stream = nullptr;
        CHECK_COND(aclInit(nullptr) == ACL_SUCCESS, "aclInit failed.");
        CHECK_COND(aclrtSetDevice(deviceId) == ACL_SUCCESS, "aclrtSetDevice failed.");
        CHECK_COND(aclrtCreateStream(&stream) == ACL_SUCCESS, "aclrtCreateStream failed.");

        constexpr uint32_t AIC_NUM = 16;

        std::vector<uint16_t> hostA(M * K);
        std::vector<uint16_t> hostB(K * N);
        mm_tut::MakeUniformInput(hostA);
        mm_tut::MakeUniformInput(hostB);

        size_t szA = M * K * sizeof(uint16_t);
        size_t szB = K * N * sizeof(uint16_t);
        size_t szC = M * N * sizeof(uint16_t);
        uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr;
        CHECK_COND(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dA failed.");
        CHECK_COND(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dB failed.");
        CHECK_COND(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS, "aclrtMalloc dC failed.");
        CHECK_COND(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS, "aclrtMemcpy dA failed.");
        CHECK_COND(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS, "aclrtMemcpy dB failed.");
        std::vector<uint16_t> outC(M * N, 0);

        // golden 抽检：1024 个固定种子位置（种子固定，两个变体的首次检查与计时后复检
        // 都在同一组位置上比对）；解码后非有限值直接判不达标。
        auto spotCheck = [&](double& maxErr) -> uint32_t {
            std::mt19937 posGen(1);
            std::uniform_int_distribution<uint32_t> iDist(0, M - 1);
            std::uniform_int_distribution<uint32_t> jDist(0, N - 1);
            uint32_t bad = 0;
            maxErr = 0.0;
            for (int s = 0; s < 1024; ++s) {
                uint32_t i = iDist(posGen), j = jDist(posGen);
                double acc = 0.0;
                for (uint32_t p = 0; p < K; ++p) {
                    acc += static_cast<double>(mm_tut::HalfBitsToFloat(hostA[i * K + p])) *
                           static_cast<double>(mm_tut::HalfBitsToFloat(hostB[p * N + j]));
                }
                const float got = mm_tut::HalfBitsToFloat(outC[i * N + j]);
                if (!std::isfinite(got)) { ++bad; continue; }
                double diff = std::fabs(static_cast<double>(got) - acc);
                if (diff > maxErr) { maxErr = diff; }
                if (diff > 1e-2 + 1e-2 * std::fabs(acc)) { ++bad; }
            }
            return bad;
        };

        std::cout << "shape: M=32, K=N=4096 (16 AIC, fp16 in / fp16 out, full-load template demo)" << std::endl;

        // 单变体流程：首次执行抽检 -> 计时 -> 计时后复检（两次结果共同纳入退出码）
        auto runVariant = [&](const char* tag, const char* perfTag, auto&& run) -> uint32_t {
            run();
            CHECK_COND(aclrtSynchronizeStream(stream) == ACL_SUCCESS, "aclrtSynchronizeStream failed.");
            CHECK_COND(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS,
                       "aclrtMemcpy outC failed.");
            double err1 = 0.0;
            const uint32_t bad1 = spotCheck(err1);
            std::cout << tag << " spot-check: max abs err " << err1 << ", bad " << bad1 << "/1024"
                      << (bad1 == 0 ? " [PASS]" : " [FAILED]") << std::endl;

            double ms = 0.0;
            CHECK_COND(mm_tut::TimedRun(run, WARMUP, ITERS, stream, &ms),
                       "aclrtSynchronizeStream failed during timing.");
            CHECK_COND(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS,
                       "aclrtMemcpy outC(recheck) failed.");
            double err2 = 0.0;
            const uint32_t bad2 = spotCheck(err2);
            std::cout << tag << " spot-check (post-timing): max abs err " << err2 << ", bad " << bad2 << "/1024"
                      << (bad2 == 0 ? " [PASS]" : " [FAILED]") << std::endl;
            std::cout << perfTag << ms << " ms/iter" << std::endl;
            return bad1 + bad2;
        };

        auto runStream = [&]() { mm_stream<<<AIC_NUM, 0, stream>>>(dA, dB, dC); };
        auto runFullload = [&]() { mm_fullload<<<AIC_NUM, 0, stream>>>(dA, dB, dC); };

        const uint32_t badS = runVariant("stream  ", "stream   (A streamed per N-tile): ", runStream);
        const uint32_t badF = runVariant("fullload", "fullload (aL1 resident):          ", runFullload);

        CHECK_COND(aclrtFree(dA) == ACL_SUCCESS, "aclrtFree dA failed.");
        CHECK_COND(aclrtFree(dB) == ACL_SUCCESS, "aclrtFree dB failed.");
        CHECK_COND(aclrtFree(dC) == ACL_SUCCESS, "aclrtFree dC failed.");
        CHECK_COND(aclrtDestroyStream(stream) == ACL_SUCCESS, "aclrtDestroyStream failed.");
        CHECK_COND(aclrtResetDevice(deviceId) == ACL_SUCCESS, "aclrtResetDevice failed.");
        CHECK_COND(aclFinalize() == ACL_SUCCESS, "aclFinalize failed.");
        return (badS == 0 && badF == 0) ? 0 : 1;
    } catch (const std::exception& e) {
        std::cerr << e.what() << std::endl;
        return 1;
    }
}
