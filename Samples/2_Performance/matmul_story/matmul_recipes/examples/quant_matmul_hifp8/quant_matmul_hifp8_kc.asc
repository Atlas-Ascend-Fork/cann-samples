/*!
 * \file quant_matmul_hifp8_kc.asc
 * \brief HiFloat8 KC sample: per-token x1 + per-channel x2 (MIX architecture, no blaze dependency).
 *        AIC: cube kernel computes A@B, L0C→UB via fixpipe (NoQuant, no scale).
 *        AIV: epilogue reads UB, applies pertoken + perchannel scales, writes bf16 to GM.
 *        Single launch: AIC+AIV cooperate per tile via CrossCoreSetFlag/CrossCoreWaitFlag
 *        (AIC→AIV flag 0x8 on PIPE_FIX, AIV→AIC flag 0x9 on PIPE_V).
 */

#include <cstdint>
#include <cstdlib>
#include <exception>
#include <iostream>
#include <memory>
#include <string>
#include <type_traits>

#include "acl/acl.h"
#include "kernel_operator.h"

#include "host_utils/acl_utils.h"
#include "host_utils/common_utils.h"
#include "host_utils/io_utils.h"
#include "utils/constant.h"

#include "tiling/quant_matmul_hifp8_tiling_data.h"
#include "tiling/quant_matmul_hifp8_tiling_swat.h"

#include "block/block_mmad.h"
#include "block/block_scheduler_policy.h"
#include "policy/dispatch_policy.h"
#include "kernel/quant_matmul_hifp8_kc_mix_kernel.h"

template <class LAYOUT_A, class LAYOUT_B, class LAYOUT_C>
__global__ __aicore__ __mix__(1, 2) void MatmulHiFp8KcMixKernel(
    GM_ADDR dA, GM_ADDR dB, GM_ADDR dScaleA, GM_ADDR dScaleB, GM_ADDR dC, const QuantMatmulHifp8TilingData tilingData)
{
    using AType = hifloat8_t;
    using BType = hifloat8_t;
    using CType = float;
    using DispatchPolicy = MatmulWithScaleMix<NO_FULL_LOAD_MODE>;
    using ProblemShape = MatmulShape;

    using BlockMmad = Block::BlockMmad<DispatchPolicy, AType, LAYOUT_A, BType, LAYOUT_B, CType, LAYOUT_C>;
    using BlockEpilogue = QuantMatmulHifp8Kc::QuantMatmulHifp8KcEpilogue;
    using KernelImpl = QuantMatmulHifp8Kc::KcMixKernel<ProblemShape, BlockMmad, BlockEpilogue>;

    using Params = typename KernelImpl::Params;
    using BlockMmadParams = typename BlockMmad::Params;
    using QBMMTiling = typename KernelImpl::QBMMTiling;
    using EpilogueParams = typename BlockEpilogue::Params;

    ProblemShape problemShape{tilingData.m, tilingData.n, tilingData.k, 1L};
    BlockMmadParams mmadParams{dA, dB};
    typename KernelImpl::BlockSchedulerParams schedulerParams{
        tilingData.baseM,
        tilingData.baseN,
        tilingData.mTailTile,
        tilingData.nTailTile,
        tilingData.mBaseTailSplitCnt,
        tilingData.nBaseTailSplitCnt,
        tilingData.mTailMain,
        tilingData.nTailMain};
    QBMMTiling qbmmParams{tilingData.kAL1,  tilingData.kBL1,  tilingData.nBufferNum, tilingData.baseM,
                          tilingData.baseN, tilingData.baseK, tilingData.dbL0c};
    EpilogueParams epiParams;
    epiParams.x2ScaleGmAddr = dScaleB;
    epiParams.x1ScaleGmAddr = dScaleA;
    epiParams.outGmAddr = dC;
    epiParams.m = tilingData.m;
    epiParams.n = tilingData.n;
    epiParams.baseM = tilingData.baseM;
    epiParams.baseN = tilingData.baseN;

    Params params{problemShape, mmadParams, schedulerParams, qbmmParams, epiParams};
    KernelImpl kernel;
    kernel(params);
}

namespace {
template <bool TransA, bool TransB>
void LaunchKernel(
    GM_ADDR dA, GM_ADDR dB, GM_ADDR dScaleA, GM_ADDR dScaleB, GM_ADDR dC, const QuantMatmulHifp8TilingData& tilingData,
    aclrtStream stream)
{
    using LAYOUT_A = std::conditional_t<
        TransA, asc::te::frame_layout_format<asc::te::dn_ext_layout_ptn>,
        asc::te::frame_layout_format<asc::te::nd_ext_layout_ptn>>;
    using LAYOUT_B = std::conditional_t<
        TransB, asc::te::frame_layout_format<asc::te::dn_ext_layout_ptn>,
        asc::te::frame_layout_format<asc::te::nd_ext_layout_ptn>>;
    using LAYOUT_C = asc::te::frame_layout_format<asc::te::nd_ext_layout_ptn>;

    MatmulHiFp8KcMixKernel<LAYOUT_A, LAYOUT_B, LAYOUT_C>
        <<<tilingData.usedCoreNum, nullptr, stream>>>(dA, dB, dScaleA, dScaleB, dC, tilingData);
}
} // namespace

static void FillSampleTiling(
    uint64_t m, uint64_t n, uint64_t k, bool transA, bool transB, QuantMatmulHifp8TilingData& tilingData)
{
    /* MIX architecture: AIC only computes A@B (NoQuant fixpipe, no scale applied on
       the cube side); all scales are applied in the AIV epilogue UB. The quant modes
       merely describe operator semantics (x1 pertoken + x2 perchannel) and are not
       read by the MIX kernel; isMixArchitecture=true makes the perchannel scale
       exempt from the L1 reservation (GetPerChannelScaleReservation returns 0). */
    QuantMatmulHifp8Config cfg{};
    cfg.x1QuantMode = hifp8::KERNEL_QUANT_PERTOKEN;
    cfg.x2QuantMode = hifp8::KERNEL_QUANT_PERCHANNEL;
    cfg.scaleDtypeSize = sizeof(float);
    cfg.isMixArchitecture = true;

    QuantMatmulHifp8TilingSwat tilingEngine;
    tilingEngine.SetQuantConfig(cfg);
    tilingEngine.GetTilingData(m, n, k, transA, transB, tilingData);
}

int main(int argc, char* argv[])
{
    uint64_t m = 0;
    uint64_t k = 0;
    uint64_t n = 0;
    bool transA = false;
    bool transB = false;
    try {
        ParseArguments(argc, argv, m, k, n, transA, transB);
    } catch (const std::exception& e) {
        std::cerr << e.what() << std::endl;
        PrintUsage(argv[0]);
        return 1;
    }

    constexpr int32_t deviceId = 0;

    try {
        QuantMatmulHifp8TilingData tilingData{};
        FillSampleTiling(m, n, k, transA, transB, tilingData);

        AclRtSession aclSession(deviceId);
        aclSession.Init();
        aclrtStream stream = aclSession.GetStream();

        uint64_t sizeA = (m * k) * sizeof(uint8_t);
        uint64_t sizeB = (k * n) * sizeof(uint8_t);
        uint64_t sizeC = m * n * sizeof(uint16_t);
        uint64_t sizeScaleA = m * sizeof(float);
        uint64_t sizeScaleB = n * sizeof(float);

        ExampleIoPaths paths = GetExampleIoPaths();

        uint8_t* hA = nullptr;
        uint8_t* hB = nullptr;
        float* hScaleA = nullptr;
        float* hScaleB = nullptr;
        uint16_t* hC = nullptr;

        uint8_t* dA = nullptr;
        uint8_t* dB = nullptr;
        uint8_t* dScaleA = nullptr;
        uint8_t* dScaleB = nullptr;
        uint8_t* dC = nullptr;

        CHECK_COND(
            aclrtMallocHost((void**)&hA, sizeA) == ACL_SUCCESS, "Failed to allocate the host buffer for input A.");
        std::unique_ptr<void, aclError (*)(void*)> hostA(hA, aclrtFreeHost);
        CHECK_COND(
            aclrtMallocHost((void**)&hB, sizeB) == ACL_SUCCESS, "Failed to allocate the host buffer for input B.");
        std::unique_ptr<void, aclError (*)(void*)> hostB(hB, aclrtFreeHost);
        CHECK_COND(
            aclrtMallocHost((void**)&hC, sizeC) == ACL_SUCCESS, "Failed to allocate the host buffer for output C.");
        std::unique_ptr<void, aclError (*)(void*)> hostC(hC, aclrtFreeHost);
        CHECK_COND(
            aclrtMallocHost((void**)&hScaleA, sizeScaleA) == ACL_SUCCESS,
            "Failed to allocate the host buffer for scaleA.");
        std::unique_ptr<void, aclError (*)(void*)> hostScaleA(hScaleA, aclrtFreeHost);
        CHECK_COND(
            aclrtMallocHost((void**)&hScaleB, sizeScaleB) == ACL_SUCCESS,
            "Failed to allocate the host buffer for scaleB.");
        std::unique_ptr<void, aclError (*)(void*)> hostScaleB(hScaleB, aclrtFreeHost);

        CHECK_COND(ReadExactFile(paths.inputDir + "/x1.bin", hA, sizeA), "Failed to read x1.bin.");
        CHECK_COND(ReadExactFile(paths.inputDir + "/x2.bin", hB, sizeB), "Failed to read x2.bin.");
        CHECK_COND(
            ReadExactFile(paths.inputDir + "/pertoken_scale.bin", hScaleA, sizeScaleA),
            "Failed to read pertoken_scale.bin.");
        CHECK_COND(ReadExactFile(paths.inputDir + "/scale.bin", hScaleB, sizeScaleB), "Failed to read scale.bin.");

        for (int32_t i = 0; i < EXAMPLE_KERNEL_RUN_COUNT; i++) {
            CHECK_COND(
                aclrtMalloc((void**)&dA, sizeA, ACL_MEM_MALLOC_HUGE_ONLY) == ACL_SUCCESS,
                "Failed to allocate the device buffer for input A.");
            std::unique_ptr<void, aclError (*)(void*)> deviceA(dA, aclrtFree);
            CHECK_COND(
                aclrtMalloc((void**)&dB, sizeB, ACL_MEM_MALLOC_HUGE_ONLY) == ACL_SUCCESS,
                "Failed to allocate the device buffer for input B.");
            std::unique_ptr<void, aclError (*)(void*)> deviceB(dB, aclrtFree);
            CHECK_COND(
                aclrtMalloc((void**)&dScaleA, sizeScaleA, ACL_MEM_MALLOC_HUGE_ONLY) == ACL_SUCCESS,
                "Failed to allocate the device buffer for scaleA.");
            std::unique_ptr<void, aclError (*)(void*)> deviceScaleA(dScaleA, aclrtFree);
            CHECK_COND(
                aclrtMalloc((void**)&dScaleB, sizeScaleB, ACL_MEM_MALLOC_HUGE_ONLY) == ACL_SUCCESS,
                "Failed to allocate the device buffer for scaleB.");
            std::unique_ptr<void, aclError (*)(void*)> deviceScaleB(dScaleB, aclrtFree);
            CHECK_COND(
                aclrtMalloc((void**)&dC, sizeC, ACL_MEM_MALLOC_HUGE_ONLY) == ACL_SUCCESS,
                "Failed to allocate the device buffer for output C.");
            std::unique_ptr<void, aclError (*)(void*)> deviceC(dC, aclrtFree);

            CHECK_COND(
                aclrtMemcpyAsync(dA, sizeA, hA, sizeA, ACL_MEMCPY_HOST_TO_DEVICE, stream) == ACL_SUCCESS,
                "Failed to copy input A from host to device.");
            CHECK_COND(
                aclrtMemcpyAsync(dB, sizeB, hB, sizeB, ACL_MEMCPY_HOST_TO_DEVICE, stream) == ACL_SUCCESS,
                "Failed to copy input B from host to device.");
            CHECK_COND(
                aclrtMemcpyAsync(dScaleA, sizeScaleA, hScaleA, sizeScaleA, ACL_MEMCPY_HOST_TO_DEVICE, stream) ==
                    ACL_SUCCESS,
                "Failed to copy scaleA from host to device.");
            CHECK_COND(
                aclrtMemcpyAsync(dScaleB, sizeScaleB, hScaleB, sizeScaleB, ACL_MEMCPY_HOST_TO_DEVICE, stream) ==
                    ACL_SUCCESS,
                "Failed to copy scaleB from host to device.");

            if (transA && transB) {
                LaunchKernel<true, true>(dA, dB, dScaleA, dScaleB, dC, tilingData, stream);
            } else if (transA && !transB) {
                LaunchKernel<true, false>(dA, dB, dScaleA, dScaleB, dC, tilingData, stream);
            } else if (!transA && transB) {
                LaunchKernel<false, true>(dA, dB, dScaleA, dScaleB, dC, tilingData, stream);
            } else {
                LaunchKernel<false, false>(dA, dB, dScaleA, dScaleB, dC, tilingData, stream);
            }

            CHECK_COND(
                aclrtMemcpyAsync(hC, sizeC, dC, sizeC, ACL_MEMCPY_DEVICE_TO_HOST, stream) == ACL_SUCCESS,
                "Failed to copy output C from device to host.");
            CHECK_COND(
                aclrtSynchronizeStream(stream) == ACL_SUCCESS,
                "Failed to synchronize the ACL stream after kernel execution.");
        }

        CHECK_COND(WriteFile(paths.outputDir + "/npu_out.bin", hC, sizeC), "Failed to write npu_out.bin.");
        std::string cmd =
            "cd \"" + paths.baseDir + "\" && python3 verify_result.py " + std::to_string(m) + " " + std::to_string(n);
        if (std::system(cmd.c_str()) != 0) {
            return 1;
        }
        return 0;
    } catch (const std::exception& e) {
        std::cerr << e.what() << std::endl;
        return 1;
    }
}
