#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "../common/host_utils.h"

constexpr uint32_t M = 4096;
constexpr uint32_t N = 4096;
constexpr uint32_t K = 4096;
constexpr float ALPHA = 0.1f;
constexpr uint32_t TILE_M = 128;
constexpr uint32_t TILE_N = 256;
constexpr uint32_t K_L1 = 128;
constexpr uint32_t K_L0 = 64;
constexpr uint32_t K_CHUNKS = K / K_L1;
constexpr uint32_t L0_STEPS = K_L1 / K_L0;
constexpr uint32_t M_TILES = M / TILE_M;
constexpr uint32_t N_TILES = N / TILE_N;
constexpr uint32_t WAVES = M_TILES * N_TILES / 16; // 每 AIC 32 个 tile
constexpr uint16_t CV_FLAG = 0x8;
constexpr int WARMUP = 5;
constexpr int ITERS = 20;

// ---------------- AIC 侧：低阶 cube matmul，逐 tile 通知 ----------------
class AicMatmul {
public:
    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
    {
        aGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a));
        bGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b));
        cGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c));
        AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0aAlloc;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0bAlloc;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0cAlloc;
        a1[0] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        a1[1] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        a1[2] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        a1[3] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        b1[0] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        b1[1] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        b1[2] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        b1[3] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        a2[0] = l0aAlloc.Alloc<AscendC::TPosition::A2, half>(TILE_M * K_L0);
        a2[1] = l0aAlloc.Alloc<AscendC::TPosition::A2, half>(TILE_M * K_L0);
        b2[0] = l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N);
        b2[1] = l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N);
        c0 = l0cAlloc.Alloc<AscendC::TPosition::CO1, float>(TILE_M * TILE_N);
        core = AscendC::GetBlockIdx();
        // 预置反向旗：L1 4 级环 + L0 2 级环 + FIX 环
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID4);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID5);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID6);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t w = 0; w < WAVES; ++w) {
            // ASWT 式 4x4 tile 窗口 + 蛇形：窗口行 wr=8 个、窗口列 wc=4 个，奇数行反向
            const uint32_t wPerRow = N_TILES / 4;
            const uint32_t wr = w / wPerRow;
            const uint32_t wcRaw = w % wPerRow;
            const uint32_t wc = (wr & 1) ? (wPerRow - 1 - wcRaw) : wcRaw;
            const uint32_t m0 = (wr * 4 + (core & 3)) * TILE_M;
            const uint32_t n0 = (wc * 4 + (core >> 2)) * TILE_N;
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
            for (uint32_t kc = 0; kc < K_CHUNKS; ++kc) {
                const uint32_t lb = kc & 3;
                const uint32_t kL1Off = kc * K_L1;
                const AscendC::TEventID evL1 = static_cast<AscendC::TEventID>(EVENT_ID1 + lb);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(evL1);
                AscendC::DataCopy(
                    a1[lb], aGM[static_cast<uint64_t>(m0) * K + kL1Off],
                    AscendC::Nd2NzParams{1, TILE_M, K_L1, 0, K, TILE_M, 1, 0});
                AscendC::DataCopy(
                    b1[lb], bGM[static_cast<uint64_t>(kL1Off) * N + n0],
                    AscendC::Nd2NzParams{1, K_L1, TILE_N, 0, N, K_L1, 1, 0});
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(evL1);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(evL1);
                for (uint32_t j = 0; j < L0_STEPS; ++j) {
                    const uint32_t q = j & 1;
                    const AscendC::TEventID evL0 = (q == 0) ? EVENT_ID5 : EVENT_ID6;
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(evL0);
                    for (uint32_t i = 0; i < TILE_M / 16; ++i) {
                        AscendC::LoadData(
                            a2[q][i * K_L0 * 16], a1[lb][(j * (K_L0 / 16) * (TILE_M / 16) + i) * 256],
                            AscendC::LoadData2DParams{0, K_L0 / 16, TILE_M / 16, 0, 0, false, 0});
                    }
                    for (uint32_t i = 0; i < K_L0 / 16; ++i) {
                        AscendC::LoadData(
                            b2[q][i * TILE_N * 16], b1[lb][(j * (K_L0 / 16) + i) * 256],
                            AscendC::LoadData2DParams{0, TILE_N / 16, K_L1 / 16, 0, 0, true, 0});
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(evL0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(evL0);
                    AscendC::Mmad(
                        c0, a2[q], b2[q],
                        AscendC::MmadParams{TILE_M, TILE_N, K_L0, 0, false, kc == 0 && j == 0});
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(evL0);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(evL1);
            }
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::Fixpipe(
                cGM[static_cast<uint64_t>(m0) * N + n0], c0,
                AscendC::FixpipeParamsV220{TILE_N, TILE_M, TILE_M, N, false, QuantMode_t::NoQuant,
                                           0, 1, 0, 0, 0});
            // fixpipe 在同一 FIX 流水内有序，紧随其后的交叉旗发出时数据已落 GM
            AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(CV_FLAG);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        }
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        // 排空环启动预置留下的未消费旗（旗状态跨 launch 残留，不排空会污染下一个 kernel）
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID4);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID6);
    }

private:
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<float> cGM;
    AscendC::LocalTensor<half> a1[4];
    AscendC::LocalTensor<half> b1[4];
    AscendC::LocalTensor<half> a2[2];
    AscendC::LocalTensor<half> b2[2];
    AscendC::LocalTensor<float> c0;
    uint32_t core = 0;
};

// ---------------- AIV 侧：逐 tile 等旗，LeakyRelu 半块 ----------------
__aicore__ inline void AivLeakyRelu(__gm__ uint8_t* c)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> qX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> qY;
    // 半块 tile = 64 行 x 256 列 fp32 = 64KB，分 2 chunk（各 32 行 = 32KB）双缓冲：4x32KB=128KB <= UB 191.75KB
    pipe.InitBuffer(qX, 2, 32 * TILE_N * sizeof(float));
    pipe.InitBuffer(qY, 2, 32 * TILE_N * sizeof(float));
    AscendC::GlobalTensor<float> cGM;
    cGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c));
    const uint32_t core = AscendC::GetBlockIdx() / 2;   // 配对的 AIC 号
    const uint32_t sub = AscendC::GetBlockIdx() % 2;    // 0/2AIV：上下半块
    for (uint32_t w = 0; w < WAVES; ++w) {
        // 与 AIC 侧一致的 4x4 窗口蛇形映射
        const uint32_t wPerRow = N_TILES / 4;
        const uint32_t wr = w / wPerRow;
        const uint32_t wcRaw = w % wPerRow;
        const uint32_t wc = (wr & 1) ? (wPerRow - 1 - wcRaw) : wcRaw;
        const uint32_t m0 = (wr * 4 + (core & 3)) * TILE_M;
        const uint32_t n0 = (wc * 4 + (core >> 2)) * TILE_N;
        AscendC::CrossCoreWaitFlag(CV_FLAG);
        const uint64_t tileBase = static_cast<uint64_t>(m0 + sub * 64) * N + n0;
        for (uint32_t cc = 0; cc < 2; ++cc) {           // 每半块 2 个 chunk（各 32 行）
            const uint64_t off = tileBase + cc * 32 * N;
            AscendC::LocalTensor<float> xl = qX.AllocTensor<float>();
            // 32 行 x 1KB，行间跨整行 4096 fp32
            AscendC::DataCopy(xl, cGM[off],
                AscendC::DataCopyParams{32, TILE_N * sizeof(float) / 32,
                                        (N - TILE_N) * sizeof(float) / 32, 0});
            qX.EnQue(xl);
            xl = qX.DeQue<float>();
            AscendC::LocalTensor<float> yl = qY.AllocTensor<float>();
            AscendC::LeakyRelu(yl, xl, ALPHA, 32 * TILE_N);
            qY.EnQue(yl);
            yl = qY.DeQue<float>();
            AscendC::DataCopy(cGM[off], yl,
                AscendC::DataCopyParams{32, TILE_N * sizeof(float) / 32, 0,
                                        (N - TILE_N) * sizeof(float) / 32});
            qX.FreeTensor(xl);
            qY.FreeTensor(yl);
        }
    }
}

__global__ __mix__(1, 2) void matmul_leakyrelu_mix_lowlevel(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        AicMatmul op;
        op.Init(a, b, c);
        op.Process();
    }
    if ASCEND_IS_AIV {
        AivLeakyRelu(c);
    }
}

// ---------------- host ----------------
int32_t main()
{
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    std::mt19937 gen(0);
    std::vector<uint16_t> hostA(M * K);
    std::vector<uint16_t> hostB(K * N);
    FillRandomHalf(hostA, gen);
    FillRandomHalf(hostB, gen);

    size_t szA = M * K * sizeof(uint16_t);
    size_t szB = K * N * sizeof(uint16_t);
    size_t szC = M * N * sizeof(float);
    uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE));

    auto run = [&]() { matmul_leakyrelu_mix_lowlevel<<<16, 0, stream>>>(dA, dB, dC); };
    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    std::vector<float> outC(M * N, 0.0f);
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));

    // NaN/Inf 反向自检：精度检查逻辑本身必须先能识别非有限值，防止把非法输出报成 PASS
    if (!SpotCheckNegativeSelfTest()) {
        std::cerr << "[ERROR] spot-check negative self-test failed" << std::endl;
        return 1;
    }
    uint32_t bad = 0;
    double maxErr = 0.0;
    SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, true, maxErr, &bad);
    std::cout << "step08 4buf+aswt spot-check: max abs err " << maxErr << ", bad " << bad << "/1024"
              << (bad == 0 ? " [PASS]" : " [FAILED]") << std::endl;
    if (bad != 0) { return 1; }

    double ms = 0.0;
    if (!TimeKernelMs(run, WARMUP, ITERS, stream, ms)) {
        std::cout << "[ERROR] 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        return 1;
    }
    std::cout << "step08 lowlevel fused 4buf+aswt: " << ms << " ms/iter  (matmul 部分 "
              << (2.0 * M * N * K / (ms * 1e9)) << " TFLOPS 等效)" << std::endl;

    // 计时后重新拷回最终输出复检：首次 PASS 不覆盖连续执行时的流水状态/缓冲复用问题
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));
    uint32_t bad2 = 0;
    double maxErr2 = 0.0;
    SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, true, maxErr2, &bad2);
    std::cout << "post-timing spot-check: max abs err " << maxErr2 << ", bad " << bad2 << "/1024"
              << (bad2 == 0 ? " [PASS]" : " [FAILED]") << std::endl;
    if (bad2 != 0) { return 1; }

    CHECK_ACL(aclrtFree(dA));
    CHECK_ACL(aclrtFree(dB));
    CHECK_ACL(aclrtFree(dC));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}
