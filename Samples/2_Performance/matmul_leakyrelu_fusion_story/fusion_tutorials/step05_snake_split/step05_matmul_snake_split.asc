#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "../common/host_utils.h"
#include "../common/leakyrelu_vec.h"

constexpr uint32_t M = 4096;
constexpr uint32_t N = 4096;
constexpr uint32_t K = 4096;
constexpr float ALPHA = 0.1f;
constexpr uint32_t TILE = 256;
#ifndef BASE_M_FIX
#define BASE_M_FIX 128
#define BASE_N_FIX 256
#define BASE_K_FIX 64
#endif
constexpr int WARMUP = 5;
constexpr int ITERS = 20;

// ---------------- split stage 1: cube matmul with snake-window tile order ----------------
__global__ __cube__ void mm_cube_snake(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* workspace,
    AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> cGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        matmulObj;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);
    matmulObj.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    matmulObj.SetSingleShape(TILE, TILE, tiling.Ka);
    uint32_t core = AscendC::GetBlockIdx();
    uint32_t pr = core / 4;   // 窗口内行位置
    uint32_t pc = core % 4;   // 窗口内列位置
    for (uint32_t w = 0; w < 16; ++w) {
        uint32_t wC = w / 4;                            // 窗口列（外层，慢变 -> B 板驻留）
        uint32_t wR = (wC % 2 == 0) ? (w % 4) : (3 - w % 4);  // 窗口行（蛇形 -> 边界 A 板复用）
        uint32_t r = wR * 4 + pr;
        uint32_t c = wC * 4 + pc;
        matmulObj.SetTensorA(aGlobal[static_cast<uint64_t>(r) * TILE * tiling.Ka], false);
        matmulObj.SetTensorB(bGlobal[static_cast<uint64_t>(c) * TILE], false);
        matmulObj.IterateAll(cGlobal[static_cast<uint64_t>(r) * TILE * tiling.N +
                                     static_cast<uint64_t>(c) * TILE]);
    }
    matmulObj.End();
}

// ---------------- split stage 2: 多 AIV leakyrelu（common/leakyrelu_vec.h，双缓冲队列） ----------------

// ---------------- host ----------------
static AscendC::tiling::TCubeTiling GenTilingSplit(platform_ascendc::PlatformAscendC* plat, int aicNum)
{
    matmul_tiling::MultiCoreMatmulTiling tilingApi(*plat);
    tilingApi.SetDim(aicNum);
    tilingApi.SetAType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetBType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.SetFixSplit(BASE_M_FIX, BASE_N_FIX, BASE_K_FIX);   // 正规 API 固定 base tile
    tilingApi.EnableBias(false);
    tilingApi.SetBufferSpace(-1, -1, -1);
    AscendC::tiling::TCubeTiling t;
    if (tilingApi.GetTiling(t) == -1) {
        std::cout << "gen tiling (split) failed" << std::endl;
    }
    return t;
}

int32_t main()
{
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int aicNum = plat->GetCoreNumAic();
    while (aicNum > 1 && M % aicNum != 0) { --aicNum; }
    int aivNum = aicNum * 2;

    std::mt19937 gen(0);
    std::vector<uint16_t> hostA(M * K);
    std::vector<uint16_t> hostB(K * N);
    FillRandomHalf(hostA, gen);
    FillRandomHalf(hostB, gen);

    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    size_t szA = M * K * sizeof(uint16_t);
    size_t szB = K * N * sizeof(uint16_t);
    size_t szC = M * N * sizeof(float);
    size_t szWs = static_cast<size_t>(plat->GetLibApiWorkSpaceSize());
    uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr, *dMid = nullptr, *dWs = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dMid, szC, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dWs, szWs, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(dWs, szWs, 0, szWs));
    CHECK_ACL(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE));

    auto tiling = GenTilingSplit(plat, aicNum);
    // 保留 tiling API 生成的 base=128x256；直接覆盖为 256x256 会使派生字段不一致，已验证会产生错误结果。
    std::cout << "snake tiling: usedCoreNum=" << tiling.usedCoreNum << " singleCoreM=" << tiling.singleCoreM
              << " singleCoreN=" << tiling.singleCoreN << " base=" << tiling.baseM << "x" << tiling.baseN << "x"
              << tiling.baseK << std::endl;
    uint32_t perCore = M * N / aivNum;
    auto run = [&]() {
        mm_cube_snake<<<tiling.usedCoreNum, 0, stream>>>(dA, dB, dMid, dWs, tiling);
        leakyrelu_vec<<<aivNum, 0, stream>>>(dMid, dC, perCore, ALPHA);
    };
    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    std::vector<float> outC(M * N, 0.0f);
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));

    // golden spot-check
    // NaN/Inf 反向自检：精度检查逻辑本身必须先能识别非有限值，防止把非法输出报成 PASS
    if (!SpotCheckNegativeSelfTest()) {
        std::cerr << "[ERROR] spot-check negative self-test failed" << std::endl;
        return 1;
    }
    uint32_t bad = 0;
    double maxErr = 0.0;
    SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, true, maxErr, &bad);
    std::cout << "snake split spot-check: max abs err " << maxErr << ", bad " << bad << "/1024"
              << (bad == 0 ? " [PASS]" : " [FAILED]") << std::endl;
    if (bad != 0) { return 1; }

    // full pipeline timing
    double ms = 0.0;
    if (!TimeKernelMs(run, WARMUP, ITERS, stream, ms)) {
        std::cout << "[ERROR] 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        aclrtFree(dMid);
        aclrtFree(dWs);
        return 1;
    }
    std::cout << "snake split (cube snake + vector kernel): " << ms << " ms/iter" << std::endl;

    // mm-only timing（剥离 LeakyReLU，单独计 cube matmul 耗时）
    auto runMm = [&]() { mm_cube_snake<<<tiling.usedCoreNum, 0, stream>>>(dA, dB, dMid, dWs, tiling); };
    double msMm = 0.0;
    if (!TimeKernelMs(runMm, WARMUP, ITERS, stream, msMm)) {
        std::cout << "[ERROR] mm-only 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        aclrtFree(dMid);
        aclrtFree(dWs);
        return 1;
    }
    std::cout << "snake mm-only: " << msMm * 1000.0 << " us/iter  ("
              << (2.0 * M * N * K / (msMm * 1e9)) << " TFLOPS fp16)" << std::endl;

    // 计时后重跑完整链路并复检最终输出（mm-only 计时可能改写中间缓冲，重跑确保输出为融合结果）
    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));
    uint32_t bad2 = 0;
    double maxErr2 = 0.0;
    SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, true, maxErr2, &bad2);
    std::cout << "post-timing spot-check: max abs err " << maxErr2 << ", bad " << bad2 << "/1024"
              << (bad2 == 0 ? " [PASS]" : " [FAILED]") << std::endl;
    if (bad2 != 0) { return 1; }

    CHECK_ACL(aclrtFree(dA));
    CHECK_ACL(aclrtFree(dB));
    CHECK_ACL(aclrtFree(dC));
    CHECK_ACL(aclrtFree(dMid));
    CHECK_ACL(aclrtFree(dWs));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}
