#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "../common/host_utils.h"
#include "../common/leakyrelu_vec.h"

constexpr uint32_t M = 4096;
constexpr uint32_t N = 4096;
constexpr uint32_t K = 4096;
constexpr float ALPHA = 0.1f;
constexpr uint32_t TILE_M = 128;   // L0C tile: 128x256 fp32 = 128KB（整块 L0C）
constexpr uint32_t TILE_N = 256;
constexpr uint32_t K_L1 = 128;     // L1 驻留的 K chunk
constexpr uint32_t K_L0 = 64;      // 每次 Mmad 的 K
constexpr uint32_t K_CHUNKS = K / K_L1;    // 32
constexpr uint32_t L0_STEPS = K_L1 / K_L0; // 2
constexpr uint32_t M_TILES = M / TILE_M;   // 32
constexpr uint32_t N_TILES = N / TILE_N;   // 16
constexpr uint32_t WAVES = M_TILES * N_TILES / 16; // 32 波次
constexpr int WARMUP = 5;
constexpr int ITERS = 20;

// ---------------- split stage 1: low-level cube matmul ----------------
__global__ __cube__ void mm_cube_lowlevel(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<float> cGM;
    aGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a));
    bGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b));
    cGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c));

    AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0aAlloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0bAlloc;
    AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0cAlloc;
    AscendC::LocalTensor<half> a1[2] = {l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1),
                                        l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1)};
    AscendC::LocalTensor<half> b1[2] = {l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N),
                                        l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N)};
    AscendC::LocalTensor<half> a2[2] = {l0aAlloc.Alloc<AscendC::TPosition::A2, half>(TILE_M * K_L0),
                                        l0aAlloc.Alloc<AscendC::TPosition::A2, half>(TILE_M * K_L0)};
    AscendC::LocalTensor<half> b2[2] = {l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N),
                                        l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N)};
    AscendC::LocalTensor<float> c0 = l0cAlloc.Alloc<AscendC::TPosition::CO1, float>(TILE_M * TILE_N);

    const uint32_t core = AscendC::GetBlockIdx();

    // 预置反向旗，让首轮生产者 Wait 直接通过
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID3);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID4);

    for (uint32_t w = 0; w < WAVES; ++w) {
        const uint32_t tileIdx = w * 16 + core;      // 行主序 tile 编号，核按列错开
        const uint32_t m0 = (tileIdx / N_TILES) * TILE_M;
        const uint32_t n0 = (tileIdx % N_TILES) * TILE_N;
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0); // 等 L0C 被 FIX 搬空
        for (uint32_t kc = 0; kc < K_CHUNKS; ++kc) {
            const uint32_t lb = kc & 1;
            const uint32_t kL1Off = kc * K_L1;
            const AscendC::TEventID evL1 = (lb == 0) ? EVENT_ID1 : EVENT_ID2;
            // ---- MTE2: GM -> L1（ND -> NZ）----
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(evL1);
            // A tile [128m x 128k] @ (m0, kL1Off)
            AscendC::DataCopy(
                a1[lb], aGM[static_cast<uint64_t>(m0) * K + kL1Off],
                AscendC::Nd2NzParams{1, TILE_M, K_L1, 0, K, TILE_M, 1, 0});
            // B tile [128k x 256n] @ (kL1Off, n0)
            AscendC::DataCopy(
                b1[lb], bGM[static_cast<uint64_t>(kL1Off) * N + n0],
                AscendC::Nd2NzParams{1, K_L1, TILE_N, 0, N, K_L1, 1, 0});
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(evL1);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(evL1); // MTE1 等 MTE2
            for (uint32_t j = 0; j < L0_STEPS; ++j) {
                const uint32_t q = j & 1;
                const AscendC::TEventID evL0 = (q == 0) ? EVENT_ID3 : EVENT_ID4;
                // ---- MTE1: L1 -> L0（NZ -> Zz/Zn，按 16x16 分形块收集）----
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(evL0);
                for (uint32_t i = 0; i < TILE_M / 16; ++i) { // A: 8 个 m 条带 x 各 4 个 k 块
                    AscendC::LoadData(
                        a2[q][i * K_L0 * 16], a1[lb][(j * (K_L0 / 16) * (TILE_M / 16) + i) * 256],
                        AscendC::LoadData2DParams{0, K_L0 / 16, TILE_M / 16, 0, 0, false, 0});
                }
                for (uint32_t i = 0; i < K_L0 / 16; ++i) { // B: 4 个 k 条带 x 各 16 个 n 块
                    AscendC::LoadData(
                        b2[q][i * TILE_N * 16], b1[lb][(j * (K_L0 / 16) + i) * 256],
                        AscendC::LoadData2DParams{0, TILE_N / 16, K_L1 / 16, 0, 0, true, 0});
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(evL0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(evL0); // M 等 MTE1
                // ---- M: 128x256x64 累加进 L0C ----
                AscendC::Mmad(
                    c0, a2[q], b2[q],
                    AscendC::MmadParams{TILE_M, TILE_N, K_L0, 0, false, kc == 0 && j == 0});
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(evL0);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(evL1); // L1[lb] 读完，还给 MTE2
        }
        // ---- FIX: L0C -> GM（NZ -> ND，fp32 不量化）----
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::Fixpipe(
            cGM[static_cast<uint64_t>(m0) * N + n0], c0,
            AscendC::FixpipeParamsV220{TILE_N, TILE_M, TILE_M, N, false, QuantMode_t::NoQuant, 0, 1, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    }
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
    // 排空环启动预置留下的未消费旗：旗状态跨 launch 残留，不排空会污染下一个 kernel
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID3);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID4);
}

// ---------------- split stage 2: 多 AIV leakyrelu（common/leakyrelu_vec.h，同 step05）----------------

// ---------------- host（与 step05 相同口径）----------------
int32_t main()
{
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    constexpr uint32_t AIC_NUM = 16;
    constexpr uint32_t AIV_NUM = 32;

    std::mt19937 gen(0);
    std::vector<uint16_t> hostA(M * K);
    std::vector<uint16_t> hostB(K * N);
    FillRandomHalf(hostA, gen);
    FillRandomHalf(hostB, gen);

    size_t szA = M * K * sizeof(uint16_t);
    size_t szB = K * N * sizeof(uint16_t);
    size_t szC = M * N * sizeof(float);
    uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr, *dMid = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dMid, szC, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE));

    uint32_t perCore = M * N / AIV_NUM;
    auto run = [&]() {
        mm_cube_lowlevel<<<AIC_NUM, 0, stream>>>(dA, dB, dMid);
        leakyrelu_vec<<<AIV_NUM, 0, stream>>>(dMid, dC, perCore, ALPHA);
    };
    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    std::vector<float> outC(M * N, 0.0f);
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));

    // golden spot-check
    // NaN/Inf 反向自检：精度检查逻辑本身必须先能识别非有限值，防止把非法输出报成 PASS
    if (!SpotCheckNegativeSelfTest()) {
        std::cerr << "[ERROR] spot-check negative self-test failed" << std::endl;
        return 1;
    }
    uint32_t bad = 0;
    double maxErr = 0.0;
    SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, true, maxErr, &bad);
    std::cout << "lowlevel split spot-check: max abs err " << maxErr << ", bad " << bad << "/1024"
              << (bad == 0 ? " [PASS]" : " [FAILED]") << std::endl;
    if (bad != 0) { return 1; }

    // full pipeline timing
    double ms = 0.0;
    if (!TimeKernelMs(run, WARMUP, ITERS, stream, ms)) {
        std::cout << "[ERROR] 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        aclrtFree(dMid);
        return 1;
    }
    std::cout << "lowlevel split (cube + vector): " << ms << " ms/iter" << std::endl;

    // mm-only timing（对比 step05 snake mm 1011-1021us）
    auto runMm = [&]() { mm_cube_lowlevel<<<AIC_NUM, 0, stream>>>(dA, dB, dMid); };
    double msMm = 0.0;
    if (!TimeKernelMs(runMm, WARMUP, ITERS, stream, msMm)) {
        std::cout << "[ERROR] mm-only 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        aclrtFree(dMid);
        return 1;
    }
    std::cout << "lowlevel mm-only: " << msMm * 1000.0 << " us/iter  ("
              << (2.0 * M * N * K / (msMm * 1e9)) << " TFLOPS fp16)" << std::endl;

    // 计时后重跑完整链路并复检最终输出（mm-only 计时可能改写中间缓冲，重跑确保输出为融合结果）
    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));
    uint32_t bad2 = 0;
    double maxErr2 = 0.0;
    SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, true, maxErr2, &bad2);
    std::cout << "post-timing spot-check: max abs err " << maxErr2 << ", bad " << bad2 << "/1024"
              << (bad2 == 0 ? " [PASS]" : " [FAILED]") << std::endl;
    if (bad2 != 0) { return 1; }

    CHECK_ACL(aclrtFree(dA));
    CHECK_ACL(aclrtFree(dB));
    CHECK_ACL(aclrtFree(dC));
    CHECK_ACL(aclrtFree(dMid));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return 0;
}
