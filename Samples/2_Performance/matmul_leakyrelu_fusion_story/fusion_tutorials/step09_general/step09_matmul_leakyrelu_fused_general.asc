#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "../common/host_utils.h"

constexpr float ALPHA = 0.1f;
constexpr uint32_t TILE_M = 128;
constexpr uint32_t TILE_N = 256;
constexpr uint32_t K_L1 = 128;
constexpr uint32_t K_L0 = 64;
constexpr uint16_t CV_FLAG = 0x8;

// ---------------- AIC 侧：低阶 cube matmul，逐 tile 通知 ----------------
class AicMatmul {
public:
    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
                                uint32_t m, uint32_t n, uint32_t k)
    {
        M = m;
        N = n;
        K = k;
        aGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a));
        bGM.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b));
        cGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c));
        AscendC::LocalMemAllocator<AscendC::Hardware::L1> l1Alloc;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0A> l0aAlloc;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0B> l0bAlloc;
        AscendC::LocalMemAllocator<AscendC::Hardware::L0C> l0cAlloc;
        a1[0] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        a1[1] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        a1[2] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        a1[3] = l1Alloc.Alloc<AscendC::TPosition::A1, half>(TILE_M * K_L1);
        b1[0] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        b1[1] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        b1[2] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        b1[3] = l1Alloc.Alloc<AscendC::TPosition::B1, half>(K_L1 * TILE_N);
        a2[0] = l0aAlloc.Alloc<AscendC::TPosition::A2, half>(TILE_M * K_L0);
        a2[1] = l0aAlloc.Alloc<AscendC::TPosition::A2, half>(TILE_M * K_L0);
        b2[0] = l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N);
        b2[1] = l0bAlloc.Alloc<AscendC::TPosition::B2, half>(K_L0 * TILE_N);
        c0 = l0cAlloc.Alloc<AscendC::TPosition::CO1, float>(TILE_M * TILE_N);
        core = AscendC::GetBlockIdx();
        mTiles = (M + TILE_M - 1) / TILE_M;
        nTiles = (N + TILE_N - 1) / TILE_N;
        wCols = (nTiles + 3) >> 2;
        waves = ((mTiles + 3) >> 2) * wCols;
        kChunks = (K + K_L1 - 1) / K_L1;
        // 预置反向旗：L1 4 级环 + L0 2 级环 + FIX 环
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID4);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID5);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID6);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t w = 0; w < waves; ++w) {
            // ASWT 式 4x4 tile 窗口 + 蛇形：窗口行优先，奇数窗口行 N 反向
            const uint32_t wr = w / wCols;
            const uint32_t wcRaw = w - wr * wCols;
            const uint32_t wc = (wr & 1) ? (wCols - 1 - wcRaw) : wcRaw;
            const uint32_t mt = (wr << 2) + (core & 3);
            const uint32_t nt = (wc << 2) + (core >> 2);
            if (mt >= mTiles || nt >= nTiles) { continue; } // 空洞槽位：整 wave 跳过
            const uint32_t m0 = mt * TILE_M;
            const uint32_t n0 = nt * TILE_N;
            const uint32_t mSize = (M - m0 < TILE_M) ? (M - m0) : TILE_M;
            const uint32_t nSize = (N - n0 < TILE_N) ? (N - n0) : TILE_N;
            const uint16_t mFrac = static_cast<uint16_t>(mSize >> 4);
            const uint16_t nFrac = static_cast<uint16_t>(nSize >> 4);
            // dav-2201 硬件冒险（实测）：L0C 输出 footprint mSize*nSize <= 2048 fp32 且需要多步累加时，
            // L0 双缓冲下 j=1 的 LoadData 与 j=0 的 Mmad 并行会导致累加结果错乱（同点不同值）。
            // 仅边缘小 tile 命中（128x16 的 N 尾块 tile 在 N 尾16+K 尾16 组合下也必踩，阈值须到 2048）；
            // 对这些 tile 退化为 L0 单缓冲全串行（q 恒 0，旗仍逐对收支平衡）。
            const bool smallTile = (mSize * nSize <= 2048);
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
            for (uint32_t kc = 0; kc < kChunks; ++kc) {
                const uint32_t lb = kc & 3;
                const uint32_t kL1Off = kc * K_L1;
                const uint32_t kSize = (kc + 1 == kChunks) ? (K - kL1Off) : K_L1;
                const uint32_t steps = (kSize + K_L0 - 1) / K_L0;
                const uint16_t kFracL1 = static_cast<uint16_t>(kSize >> 4);
                const AscendC::TEventID evL1 = static_cast<AscendC::TEventID>(EVENT_ID1 + lb);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(evL1);
                AscendC::DataCopy(
                    a1[lb], aGM[static_cast<uint64_t>(m0) * K + kL1Off],
                    AscendC::Nd2NzParams{1, static_cast<uint16_t>(mSize), static_cast<uint16_t>(kSize), 0,
                                         static_cast<uint16_t>(K), static_cast<uint16_t>(mSize), 1, 0});
                AscendC::DataCopy(
                    b1[lb], bGM[static_cast<uint64_t>(kL1Off) * N + n0],
                    AscendC::Nd2NzParams{1, static_cast<uint16_t>(kSize), static_cast<uint16_t>(nSize), 0,
                                         static_cast<uint16_t>(N), static_cast<uint16_t>(kSize), 1, 0});
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(evL1);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(evL1);
                for (uint32_t j = 0; j < steps; ++j) {
                    const uint32_t q = smallTile ? 0 : (j & 1);
                    const uint32_t kL0 = (j + 1 == steps) ? (kSize - j * K_L0) : K_L0;
                    const uint16_t kFrac0 = static_cast<uint16_t>(kL0 >> 4);
                    const AscendC::TEventID evL0 = (q == 0) ? EVENT_ID5 : EVENT_ID6;
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(evL0);
                    for (uint32_t i = 0; i < mFrac; ++i) {
                        AscendC::LoadData(
                            a2[q][i * kL0 * 16], a1[lb][(j * (K_L0 / 16) * mFrac + i) * 256],
                            AscendC::LoadData2DParams{0, static_cast<uint8_t>(kFrac0), mFrac, 0, 0, false, 0});
                    }
                    for (uint32_t i = 0; i < kFrac0; ++i) {
                        AscendC::LoadData(
                            b2[q][i * nSize * 16], b1[lb][(j * (K_L0 / 16) + i) * 256],
                            AscendC::LoadData2DParams{0, static_cast<uint8_t>(nFrac), kFracL1, 0, 0, true, 0});
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(evL0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(evL0);
                    AscendC::Mmad(
                        c0, a2[q], b2[q],
                        AscendC::MmadParams{static_cast<uint16_t>(mSize), static_cast<uint16_t>(nSize),
                                            static_cast<uint16_t>(kL0), 0, false, kc == 0 && j == 0});
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(evL0);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(evL1);
            }
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::Fixpipe(
                cGM[static_cast<uint64_t>(m0) * N + n0], c0,
                AscendC::FixpipeParamsV220{static_cast<uint16_t>(nSize), static_cast<uint16_t>(mSize),
                                           static_cast<uint16_t>(mSize), N, false, QuantMode_t::NoQuant,
                                           0, 1, 0, 0, 0});
            // fixpipe 在同一 FIX 流水内有序，紧随其后的交叉旗发出时数据已落 GM
            AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(CV_FLAG);
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        }
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
        // 排空环启动预置留下的未消费旗（旗状态跨 launch 残留，不排空会污染下一个 kernel）
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID4);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID5);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(EVENT_ID6);
    }

private:
    AscendC::GlobalTensor<half> aGM;
    AscendC::GlobalTensor<half> bGM;
    AscendC::GlobalTensor<float> cGM;
    AscendC::LocalTensor<half> a1[4];
    AscendC::LocalTensor<half> b1[4];
    AscendC::LocalTensor<half> a2[2];
    AscendC::LocalTensor<half> b2[2];
    AscendC::LocalTensor<float> c0;
    uint32_t core = 0;
    uint32_t M = 0;
    uint32_t N = 0;
    uint32_t K = 0;
    uint32_t mTiles = 0;
    uint32_t nTiles = 0;
    uint32_t wCols = 0;
    uint32_t waves = 0;
    uint32_t kChunks = 0;
};

// ---------------- AIV 侧：逐 tile 等旗，LeakyRelu 半块 ----------------
__aicore__ inline void AivLeakyRelu(__gm__ uint8_t* c, uint32_t M, uint32_t N)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> qX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> qY;
    // 半块 tile 最大 64 行 x 256 列 fp32，分 2 chunk（各 <=32 行 = 32KB）双缓冲：4x32KB=128KB <= UB 191.75KB
    pipe.InitBuffer(qX, 2, 32 * TILE_N * sizeof(float));
    pipe.InitBuffer(qY, 2, 32 * TILE_N * sizeof(float));
    AscendC::GlobalTensor<float> cGM;
    cGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c));
    const uint32_t core = AscendC::GetBlockIdx() / 2;   // 配对的 AIC 号
    const uint32_t sub = AscendC::GetBlockIdx() % 2;    // 0/1：上下半块
    const uint32_t mTiles = (M + TILE_M - 1) / TILE_M;
    const uint32_t nTiles = (N + TILE_N - 1) / TILE_N;
    const uint32_t wCols = (nTiles + 3) >> 2;
    const uint32_t waves = ((mTiles + 3) >> 2) * wCols;
    for (uint32_t w = 0; w < waves; ++w) {
        // 与 AIC 侧一致的 4x4 窗口蛇形映射
        const uint32_t wr = w / wCols;
        const uint32_t wcRaw = w - wr * wCols;
        const uint32_t wc = (wr & 1) ? (wCols - 1 - wcRaw) : wcRaw;
        const uint32_t mt = (wr << 2) + (core & 3);
        const uint32_t nt = (wc << 2) + (core >> 2);
        if (mt >= mTiles || nt >= nTiles) { continue; }
        const uint32_t m0 = mt * TILE_M;
        const uint32_t n0 = nt * TILE_N;
        const uint32_t mSize = (M - m0 < TILE_M) ? (M - m0) : TILE_M;
        const uint32_t nSize = (N - n0 < TILE_N) ? (N - n0) : TILE_N;
        const uint32_t halfRows = mSize >> 1;   // 每 AIV 负责半块 mSize/2 行
        const uint32_t chunkRows = mSize >> 2;  // 分 2 chunk，各 mSize/4 行
        AscendC::CrossCoreWaitFlag(CV_FLAG);
        const uint64_t tileBase = static_cast<uint64_t>(m0 + sub * halfRows) * N + n0;
        for (uint32_t cc = 0; cc < 2; ++cc) {
            const uint64_t off = tileBase + static_cast<uint64_t>(cc) * chunkRows * N;
            AscendC::LocalTensor<float> xl = qX.AllocTensor<float>();
            AscendC::DataCopy(xl, cGM[off],
                AscendC::DataCopyParams{static_cast<uint16_t>(chunkRows),
                                        static_cast<uint16_t>(nSize * sizeof(float) / 32),
                                        static_cast<uint16_t>((N - nSize) * sizeof(float) / 32), 0});
            qX.EnQue(xl);
            xl = qX.DeQue<float>();
            AscendC::LocalTensor<float> yl = qY.AllocTensor<float>();
            AscendC::LeakyRelu(yl, xl, ALPHA, chunkRows * nSize);
            qY.EnQue(yl);
            yl = qY.DeQue<float>();
            AscendC::DataCopy(cGM[off], yl,
                AscendC::DataCopyParams{static_cast<uint16_t>(chunkRows),
                                        static_cast<uint16_t>(nSize * sizeof(float) / 32), 0,
                                        static_cast<uint16_t>((N - nSize) * sizeof(float) / 32)});
            qX.FreeTensor(xl);
            qY.FreeTensor(yl);
        }
    }
}

__global__ __mix__(1, 2) void matmul_leakyrelu_mix_general(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
                                                           uint32_t m, uint32_t n, uint32_t k)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        AicMatmul op;
        op.Init(a, b, c, m, n, k);
        op.Process();
    }
    if ASCEND_IS_AIV {
        AivLeakyRelu(c, m, n);
    }
}

// ---------------- host ----------------
static int32_t RunOne(uint32_t M, uint32_t N, uint32_t K, aclrtStream stream)
{
    if (M == 0 || N == 0 || K == 0 || (M & 15) != 0 || (N & 15) != 0 || (K & 15) != 0) {
        std::cout << M << "x" << N << "x" << K << ": M/N/K 必须为 16 的正整数倍 [ERROR]" << std::endl;
        return 1;
    }
    // Nd2NzParams.srcDValue（GM 行跨度）在 dav-2201 上为 uint16_t，K/N 超过 65535 会被静默截断
    //（如 65536 截断为 0），导致 DataCopy 读错行；Host 侧明确拒绝超出底层接口跨度范围的 shape
    if (K > UINT16_MAX || N > UINT16_MAX) {
        std::cout << M << "x" << N << "x" << K << ": K/N 超过 Nd2Nz 跨度上限 65535 [ERROR]" << std::endl;
        return 1;
    }
    std::mt19937 gen(0);
    std::vector<uint16_t> hostA(static_cast<size_t>(M) * K);
    std::vector<uint16_t> hostB(static_cast<size_t>(K) * N);
    FillRandomHalf(hostA, gen);
    FillRandomHalf(hostB, gen);

    size_t szA = hostA.size() * sizeof(uint16_t);
    size_t szB = hostB.size() * sizeof(uint16_t);
    size_t szC = static_cast<size_t>(M) * N * sizeof(float);
    uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE));

    auto run = [&]() { matmul_leakyrelu_mix_general<<<16, 0, stream>>>(dA, dB, dC, M, N, K); };
    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    std::vector<float> outC(static_cast<size_t>(M) * N, 0.0f);
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));

    // golden spot-check：double 累加 + leakyrelu；大 shape 512 点、小 shape 1024 点，
    // 另有 1/4 点强制落在末行/末列 partial tile 条带内（边缘 tile 是泛化风险最高点）
    const bool large = (static_cast<uint64_t>(M) * N * K) >= 1000000000ull;
    const uint32_t nSamples = large ? 512 : 1024;
    std::mt19937 posGen(1);
    std::uniform_int_distribution<uint32_t> rowDist(0, M - 1);
    std::uniform_int_distribution<uint32_t> colDist(0, N - 1);
    uint32_t bad = 0;
    uint32_t total = 0;
    double maxErr = 0.0;
    auto checkPoint = [&](uint32_t i, uint32_t j) {
        double acc = GoldenDotAt(hostA, hostB, i, j, N, K);
        double golden = acc > 0.0 ? acc : static_cast<double>(ALPHA) * acc;
        float outV = outC[static_cast<size_t>(i) * N + j];
        double diff = std::fabs(static_cast<double>(outV) - golden);
        // 非有限值（NaN/Inf）直接判失败：NaN 的比较恒为 false，不做 isfinite 检查会被静默放过
        if (!std::isfinite(outV) || !std::isfinite(golden) || !std::isfinite(diff)) {
            ++bad;
            maxErr = std::numeric_limits<double>::infinity();
        } else {
            if (diff > maxErr) { maxErr = diff; }
            if (diff > 1e-2 + 1e-2 * std::fabs(golden)) { ++bad; }
        }
        ++total;
    };
    // 抽样检查封装为 lambda，首次校验与计时后复检共用同一实现
    auto spotCheck = [&](const char* tag) {
        bad = 0;
        total = 0;
        maxErr = 0.0;
        for (uint32_t s = 0; s < nSamples; ++s) { checkPoint(rowDist(posGen), colDist(posGen)); }
        const uint32_t mEdge = M % TILE_M;
        const uint32_t nEdge = N % TILE_N;
        if (mEdge != 0) {
            std::uniform_int_distribution<uint32_t> eRow(M - mEdge, M - 1);
            for (uint32_t s = 0; s < nSamples / 4; ++s) { checkPoint(eRow(posGen), colDist(posGen)); }
        }
        if (nEdge != 0) {
            std::uniform_int_distribution<uint32_t> eCol(N - nEdge, N - 1);
            for (uint32_t s = 0; s < nSamples / 4; ++s) { checkPoint(rowDist(posGen), eCol(posGen)); }
        }
        std::cout << M << "x" << N << "x" << K << tag << ": max abs err " << maxErr << ", bad " << bad << "/"
                  << total << (bad == 0 ? " [PASS]" : " [FAILED]") << std::endl;
        return bad == 0;
    };
    bool pass = spotCheck(" spot-check");

    const int warmup = large ? 3 : 5;
    const int iters = large ? 10 : 20;
    double ms = 0.0;
    if (!TimeKernelMs(run, warmup, iters, stream, ms)) {
        std::cout << M << "x" << N << "x" << K << " [ERROR] 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        return 1;
    }
    std::cout << M << "x" << N << "x" << K << " fused general: " << ms << " ms/iter  (matmul 部分 "
              << (2.0 * M * N * K / (ms * 1e9)) << " TFLOPS 等效)" << std::endl;

    // 计时后重跑一次并复检最终输出：首次 PASS 不覆盖连续执行时的同步标志/流水状态/缓冲复用问题
    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));
    pass = spotCheck(" post-timing spot-check") && pass;

    CHECK_ACL(aclrtFree(dA));
    CHECK_ACL(aclrtFree(dB));
    CHECK_ACL(aclrtFree(dC));
    return pass ? 0 : 1;
}

int32_t main(int argc, char** argv)
{
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    int32_t rc = 0;
    if (argc == 4) {
        // 命令行参数顺序为 m k n（与 matmul_tutorials 一致）：A[m,k] x B[k,n]
        uint32_t m = 0;
        uint32_t n = 0;
        uint32_t k = 0;
        if (!ParseUint32Arg(argv[1], m) || !ParseUint32Arg(argv[2], k) || !ParseUint32Arg(argv[3], n)) {
            std::cerr << "invalid M/K/N: must be positive integers" << std::endl;
            rc = 2;
        } else {
            rc = RunOne(m, n, k, stream);
        }
    } else if (argc == 1) {
        const uint32_t shapes[][3] = {
            {4096, 4096, 4096}, // 回归（step08 硬编码 shape，期望 ~0.81ms）
            {8192, 8192, 8192}, // 大
            {8192, 4096, 8192}, // 大非方
            {512, 512, 512},    // 小
            {768, 512, 640},    // 小非方（M_TILES=6 非 4 倍数窗口）
            {4032, 4032, 4032}, // 非 tile 对齐（末 tile mSize=64 / nSize=192）
            {4160, 4048, 4080}, // 三维全非对齐（M_TILES=33 空洞槽位 + K 尾块 112=64+48）
            {2080, 2064, 2096}, // K 尾块 48 单 L0 尾步；末 tile nSize=16
            {16, 65520, 16},    // K 边界：Nd2Nz 跨度上限 65535 内的最大 16 对齐值
            {16, 16, 65520},    // N 边界：同上
        };
        for (const auto& s : shapes) { rc |= RunOne(s[0], s[1], s[2], stream); }
    } else {
        std::cerr << "usage: " << argv[0] << " [M K N]  (无参则跑内置 shape 列表)" << std::endl;
        rc = 2;
    }

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return rc;
}
