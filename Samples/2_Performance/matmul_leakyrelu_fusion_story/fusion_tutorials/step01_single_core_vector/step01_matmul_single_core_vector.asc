#include <chrono>
#include <cmath>
#include <cstdint>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "../common/host_utils.h"

#ifndef KK
#define KK 4096
#endif

constexpr uint32_t M = 4096;
constexpr uint32_t N = 4096;
constexpr uint32_t K = KK;
constexpr float ALPHA = 0.1f;

constexpr uint32_t MB = 128;                 // C tile rows
constexpr uint32_t NB = 256;                 // C tile cols
constexpr uint32_t KB = 32;                  // k-tile depth
static_assert(M % MB == 0 && N % NB == 0 && K % KB == 0, "tile sizes must divide M/N/K");

constexpr int WARMUP = (KK >= 1024) ? 1 : 5;
constexpr int ITERS = (KK >= 1024) ? 2 : 50;

__global__ __aicore__ __vector__ void matmul_tiled(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qA;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qB;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qC;
    pipe.InitBuffer(qA, 1, MB * KB * sizeof(float));
    pipe.InitBuffer(qB, 1, KB * NB * sizeof(float));
    pipe.InitBuffer(qC, 1, MB * NB * sizeof(float));

    AscendC::GlobalTensor<float> aGm;
    AscendC::GlobalTensor<float> bGm;
    AscendC::GlobalTensor<float> cGm;
    aGm.SetGlobalBuffer((__gm__ float*)a);
    bGm.SetGlobalBuffer((__gm__ float*)b);
    cGm.SetGlobalBuffer((__gm__ float*)c);

    // 2D tile copy parameters (units of 32B bursts)
    AscendC::DataCopyParams aParams{(uint16_t)MB, (uint16_t)(KB * 4 / 32), (uint16_t)((K - KB) * 4 / 32), 0};
    AscendC::DataCopyParams bParams{(uint16_t)KB, (uint16_t)(NB * 4 / 32), (uint16_t)((N - NB) * 4 / 32), 0};
    AscendC::DataCopyParams cParams{(uint16_t)MB, (uint16_t)(NB * 4 / 32), 0, (uint16_t)((N - NB) * 4 / 32)};

    for (uint32_t mt = 0; mt < M / MB; ++mt) {
        for (uint32_t nt = 0; nt < N / NB; ++nt) {
            AscendC::LocalTensor<float> cLocal = qC.AllocTensor<float>();
            AscendC::Duplicate(cLocal, 0.0f, MB * NB);
            for (uint32_t kt = 0; kt < K / KB; ++kt) {
                AscendC::LocalTensor<float> aLocal = qA.AllocTensor<float>();
                AscendC::DataCopy(aLocal, aGm[mt * MB * K + kt * KB], aParams);
                qA.EnQue(aLocal);
                aLocal = qA.DeQue<float>();

                AscendC::LocalTensor<float> bLocal = qB.AllocTensor<float>();
                AscendC::DataCopy(bLocal, bGm[kt * KB * N + nt * NB], bParams);
                qB.EnQue(bLocal);
                bLocal = qB.DeQue<float>();

                for (uint32_t m = 0; m < MB; ++m) {
                    AscendC::LocalTensor<float> cRow = cLocal[m * NB];
                    for (uint32_t k = 0; k < KB; ++k) {
                        AscendC::Axpy(cRow, bLocal[k * NB], aLocal.GetValue(m * KB + k), NB);
                    }
                }
                qA.FreeTensor(aLocal);
                qB.FreeTensor(bLocal);
            }
            AscendC::LeakyRelu(cLocal, cLocal, ALPHA, MB * NB); // fused epilogue
            qC.EnQue(cLocal);
            cLocal = qC.DeQue<float>();
            AscendC::DataCopy(cGm[mt * MB * N + nt * NB], cLocal, cParams);
            qC.FreeTensor(cLocal);
        }
    }
}

int32_t main()
{
    std::mt19937 gen(0);
    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
    std::vector<float> hostA(M * K);
    std::vector<float> hostB(K * N);
    for (auto& v : hostA) { v = dist(gen); }
    for (auto& v : hostB) { v = dist(gen); }

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(deviceId));
    CHECK_ACL(aclrtCreateStream(&stream));

    uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&dA, M * K * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dB, K * N * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dC, M * N * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(dA, M * K * sizeof(float), hostA.data(), M * K * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dB, K * N * sizeof(float), hostB.data(), K * N * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE));

    std::vector<float> outC(M * N, 0.0f);

    // correctness + timing
    auto run = [&]() { matmul_tiled<<<1, nullptr, stream>>>(dA, dB, dC); };

    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outC.data(), M * N * sizeof(float), dC, M * N * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST));

    // spot-check against double golden at 1024 random positions
    std::mt19937 posGen(1);
    std::uniform_int_distribution<uint32_t> posDist(0, M * N - 1);
    uint32_t bad = 0;
    double maxErr = 0.0;
    // 抽样检查封装为 lambda，首次校验与计时后复检共用同一实现
    auto spotCheck = [&](const char* tag) {
        bad = 0;
        maxErr = 0.0;
        for (int s = 0; s < 1024; ++s) {
            uint32_t idx = posDist(posGen);
            uint32_t i = idx / N, j = idx % N;
            double acc = 0.0;
            for (uint32_t p = 0; p < K; ++p) {
                acc += static_cast<double>(hostA[i * K + p]) * hostB[p * N + j];
            }
            double golden = acc > 0.0 ? acc : static_cast<double>(ALPHA) * acc;
            float outV = outC[idx];
            double diff = std::fabs(static_cast<double>(outV) - golden);
            // 非有限值（NaN/Inf）直接判失败：NaN 的比较恒为 false，不做 isfinite 检查会被静默放过
            if (!std::isfinite(outV) || !std::isfinite(golden) || !std::isfinite(diff)) {
                ++bad;
                maxErr = std::numeric_limits<double>::infinity();
                continue;
            }
            if (diff > maxErr) { maxErr = diff; }
            if (diff > 1e-3 + 1e-3 * std::fabs(golden)) { ++bad; }
        }
        std::cout << tag << " vs double golden: max abs err " << maxErr << ", bad " << bad << "/1024"
                  << (bad == 0 ? " [PASS]" : " [FAILED]") << std::endl;
        return bad == 0;
    };
    bool ok = spotCheck("spot-check");

    // timing
    double ms = 0.0;
    if (!TimeKernelMs(run, WARMUP, ITERS, stream, ms)) {
        std::cout << "[ERROR] 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        return 1;
    }

    std::cout << "shape: M=N=" << M << ", K=" << K << " (single AIV, fp32)" << std::endl;
    std::cout << "matmul+leakyrelu (1 kernel): " << ms << " ms/iter" << std::endl;

    // 计时后重新拷回最终输出复检：首次 PASS 不覆盖连续执行时的流水状态/缓冲复用问题
    CHECK_ACL(aclrtMemcpy(outC.data(), M * N * sizeof(float), dC, M * N * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST));
    ok = spotCheck("post-timing spot-check") && ok;

    CHECK_ACL(aclrtFree(dA));
    CHECK_ACL(aclrtFree(dB));
    CHECK_ACL(aclrtFree(dC));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return ok ? 0 : 1;
}
