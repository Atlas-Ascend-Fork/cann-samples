#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <random>
#include <vector>
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "../common/host_utils.h"

#ifndef EPILOGUE
#define EPILOGUE 1
#endif

constexpr uint32_t M = 4096;
constexpr uint32_t N = 4096;
constexpr uint32_t K = 4096;
constexpr float ALPHA = 0.1f;
constexpr uint32_t BASE_M = 128;
constexpr uint32_t BASE_N = 128;
constexpr uint32_t BASE_K = 64;
constexpr uint32_t SINGLE_M = 512;
constexpr uint32_t SINGLE_N = 1024;
constexpr uint32_t GRID_M = M / SINGLE_M;   // 8
constexpr uint32_t GRID_N = N / SINGLE_N;   // 4
constexpr uint32_t ROWS_CHUNK = 16;         // relu pass: 16 rows x 1024 floats = 64KB per buffer
constexpr int WARMUP = 5;
constexpr int ITERS = 20;

__global__ __mix__(1, 2) void mm_decoupled(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
    __kfc_workspace__ __gm__ uint8_t* workspace, AscendC::tiling::TCubeTiling tiling)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<half> aGlobal;
    AscendC::GlobalTensor<half> bGlobal;
    AscendC::GlobalTensor<float> cGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(c), tiling.M * tiling.N);
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, half>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>>
        matmulObj;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);
    matmulObj.SetOrgShape(tiling.M, tiling.N, tiling.Ka, tiling.Kb);
    uint32_t blockIdx = AscendC::GetBlockIdx();
    uint32_t mIdx = blockIdx % GRID_M;  // M inner
    uint32_t nIdx = blockIdx / GRID_M;  // N outer
    uint64_t cBase = static_cast<uint64_t>(mIdx) * tiling.singleCoreM * tiling.N +
                     static_cast<uint64_t>(nIdx) * tiling.singleCoreN;
    matmulObj.SetTensorA(aGlobal[static_cast<uint64_t>(mIdx) * tiling.singleCoreM * tiling.Ka], false);
    matmulObj.SetTensorB(bGlobal[static_cast<uint64_t>(nIdx) * tiling.singleCoreN], false);

    // ---- pass 1: cube -> C straight to GM (identical to split's mm_cube) ----
    matmulObj.IterateAll(cGlobal[cBase]);
    matmulObj.End();
    AscendC::SyncAll();  // cross-core barrier: all fixpipe C writes visible to AIV reads

#if EPILOGUE
    // ---- pass 2: AIV relu over own C slice (identical to split's leakyrelu_vec) ----
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qY;
    pipe.InitBuffer(qX, 1, ROWS_CHUNK * tiling.singleCoreN * sizeof(float));
    pipe.InitBuffer(qY, 1, ROWS_CHUNK * tiling.singleCoreN * sizeof(float));
    uint32_t rowsPerCore = tiling.singleCoreM;
    uint32_t cols = tiling.singleCoreN;
    uint16_t blockLen = static_cast<uint16_t>(cols * sizeof(float) / 32);
    uint16_t gap = static_cast<uint16_t>((tiling.N - cols) * sizeof(float) / 32);
    for (uint32_t r = 0; r < rowsPerCore; r += ROWS_CHUNK) {
        AscendC::LocalTensor<float> xLocal = qX.AllocTensor<float>();
        AscendC::DataCopy(
            xLocal, cGlobal[cBase + static_cast<uint64_t>(r) * tiling.N],
            AscendC::DataCopyParams{static_cast<uint16_t>(ROWS_CHUNK), blockLen, gap, 0});
        qX.EnQue(xLocal);
        xLocal = qX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = qY.AllocTensor<float>();
        AscendC::LeakyRelu(yLocal, xLocal, ALPHA, ROWS_CHUNK * cols);
        qX.FreeTensor(xLocal);
        qY.EnQue(yLocal);
        yLocal = qY.DeQue<float>();
        AscendC::DataCopy(
            cGlobal[cBase + static_cast<uint64_t>(r) * tiling.N], yLocal,
            AscendC::DataCopyParams{static_cast<uint16_t>(ROWS_CHUNK), blockLen, 0, gap});
        qY.FreeTensor(yLocal);
    }
#endif
}

// ---------------- host ----------------
static AscendC::tiling::TCubeTiling GenTiling(platform_ascendc::PlatformAscendC* plat, int aivNum)
{
    matmul_tiling::MultiCoreMatmulTiling tilingApi(*plat);
    tilingApi.SetDim(aivNum);
    tilingApi.SetAType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetBType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT16, false);
    tilingApi.SetCType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetBiasType(
        matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.EnableBias(false);
    tilingApi.SetFixSplit(BASE_M, BASE_N, BASE_K);
    tilingApi.SetSingleShape(SINGLE_M, SINGLE_N, -1);
    tilingApi.SetBufferSpace(-1, -1, -1);
    AscendC::tiling::TCubeTiling t;
    if (tilingApi.GetTiling(t) == -1) {
        std::cout << "gen tiling (decoupled) failed" << std::endl;
    }
    return t;
}

int32_t main()
{
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int aicNum = plat->GetCoreNumAic();
    while (aicNum > 1 && M % aicNum != 0) { --aicNum; }
    int aivNum = aicNum * 2;

    std::mt19937 gen(0);
    std::vector<uint16_t> hostA(M * K);
    std::vector<uint16_t> hostB(K * N);
    FillRandomHalf(hostA, gen);
    FillRandomHalf(hostB, gen);

    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    size_t szA = M * K * sizeof(uint16_t);
    size_t szB = K * N * sizeof(uint16_t);
    size_t szC = M * N * sizeof(float);
    size_t szWs = static_cast<size_t>(plat->GetLibApiWorkSpaceSize());
    uint8_t *dA = nullptr, *dB = nullptr, *dC = nullptr, *dWs = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&dA, szA, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dB, szB, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dC, szC, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&dWs, szWs, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(dWs, szWs, 0, szWs));
    CHECK_ACL(aclrtMemcpy(dA, szA, hostA.data(), szA, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(dB, szB, hostB.data(), szB, ACL_MEMCPY_HOST_TO_DEVICE));

    auto tiling = GenTiling(plat, aivNum);
    std::cout << "decoupled tiling: usedCoreNum=" << tiling.usedCoreNum << " singleCoreM=" << tiling.singleCoreM
              << " singleCoreN=" << tiling.singleCoreN << " base=" << tiling.baseM << "x" << tiling.baseN << "x"
              << tiling.baseK << " EPILOGUE=" << EPILOGUE << std::endl;
    if (tiling.singleCoreM != SINGLE_M || tiling.singleCoreN != SINGLE_N ||
        tiling.usedCoreNum != static_cast<uint32_t>(aivNum)) {
        std::cout << "[ERROR] decoupled tiling assumption broken" << std::endl;
        return 1;
    }
    uint32_t numBlocks = tiling.usedCoreNum / 2;
    auto run = [&]() { mm_decoupled<<<numBlocks, 0, stream>>>(dA, dB, dC, dWs, tiling); };

    run();
    CHECK_ACL(aclrtSynchronizeStream(stream));
    std::vector<float> outC(M * N, 0.0f);
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));
    // NaN/Inf 反向自检：精度检查逻辑本身必须先能识别非有限值，防止把非法输出报成 PASS
    if (!SpotCheckNegativeSelfTest()) {
        std::cerr << "[ERROR] spot-check negative self-test failed" << std::endl;
        return 1;
    }
    double maxErr = 0.0;
    bool ok = SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, EPILOGUE != 0, maxErr);
    std::cout << "decoupled spot-check: max abs err " << maxErr << (ok ? " [PASS]" : " [FAILED]") << std::endl;

    double ms = 0.0;
    if (!TimeKernelMs(run, WARMUP, ITERS, stream, ms)) {
        std::cout << "[ERROR] 计时阶段同步失败，输出无效" << std::endl;
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dC);
        aclrtFree(dWs);
        return 1;
    }
    std::cout << "decoupled (one mix kernel, split-identical passes): " << ms << " ms/iter  ("
              << (2.0 * M * N * K / (ms * 1e9)) << " TFLOPS fp16)" << std::endl;

    // verify AGAIN on the output of the last timing iteration (stress-tests the SyncAll)
    CHECK_ACL(aclrtMemcpy(outC.data(), szC, dC, szC, ACL_MEMCPY_DEVICE_TO_HOST));
    double maxErr2 = 0.0;
    bool ok2 = SpotCheck1024(outC, hostA, hostB, M, N, K, ALPHA, EPILOGUE != 0, maxErr2);
    std::cout << "post-timing spot-check: max abs err " << maxErr2 << (ok2 ? " [PASS]" : " [FAILED]") << std::endl;
    ok = ok && ok2;

    CHECK_ACL(aclrtFree(dA));
    CHECK_ACL(aclrtFree(dB));
    CHECK_ACL(aclrtFree(dC));
    CHECK_ACL(aclrtFree(dWs));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());
    return ok ? 0 : 1;
}
