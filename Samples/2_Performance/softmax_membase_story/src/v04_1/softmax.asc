// 默认启动参数：不传命令行参数时使用，集中在这里修改。
constexpr uint32_t DEFAULT_ROWS = 160;
constexpr uint32_t DEFAULT_COLS = 131072;

extern char** environ;

/* ======================== 以下是算子的 Kernel&Tiling 实现  ======================== */

template <SoftmaxTilingKey tilingKey>
__global__ __vector__ void softmax_k(__gm__ float* xGmAddr, __gm__ float* yGmAddr, SoftmaxTilingData data)
{
    // 不构造TPipe；显式初始化芯片状态及默认mask。
    AscendC::InitSocState();
    if constexpr (tilingKey == SoftmaxTilingKey::SINGLE_TAIL) {
        SoftmaxKernelOpSingleTail op;
        op.Init(yGmAddr, data);
        op.Process();
    } else if constexpr (tilingKey == SoftmaxTilingKey::FULLLOAD_WITH_DB) {
        SoftmaxKernelOpFullLoadWithDB op{data};
        op.Init(xGmAddr, yGmAddr);
        op.Process();
    } else if constexpr (tilingKey == SoftmaxTilingKey::FULLLOAD) {
        SoftmaxKernelOpFullLoad op{data};
        op.Init(xGmAddr, yGmAddr);
        op.Process();
    } else {
        SoftmaxKernelOpGeneral op{data};
        op.Init(xGmAddr, yGmAddr);
        op.Process();
    }
    // 所有固定flag已配平；退出前统一排空各泳道，不依赖TPipe析构。
    AscendC::PipeBarrier<PIPE_ALL>();
}

// RA工作空间只放在tmpLocal前段；保留源数据，不借xyLocal作临时空间。
uint32_t QueryReduceTmpBytes(uint32_t elems)
{
    const uint32_t repeats = CeilDiv(elems, UB_REPEAT_ELEMS);
    const ge::Shape shape({static_cast<int64_t>(repeats), UB_REPEAT_ELEMS});
    uint32_t maxSumBytes = 0, minSumBytes = 0, maxMaxBytes = 0, minMaxBytes = 0;
    AscendC::GetReduceSumMaxMinTmpSize(shape, ge::DT_FLOAT, AscendC::ReducePattern::RA, true, false, maxSumBytes,
                                       minSumBytes);
    AscendC::GetReduceMaxMaxMinTmpSize(shape, ge::DT_FLOAT, AscendC::ReducePattern::RA, true, false, maxMaxBytes,
                                       minMaxBytes);
    return CeilAlign(std::max({maxSumBytes, maxMaxBytes, static_cast<uint32_t>(UB_BLOCK_SIZE)}), UB_BLOCK_SIZE);
}

// GENERAL将256B的tile结果也放进tmpLocal，源数据不充当scratch。
uint32_t QueryGeneralTmpBytes(uint32_t elems, uint32_t& reduceTmpBytes)
{
    reduceTmpBytes = QueryReduceTmpBytes(elems);
    return reduceTmpBytes + UB_REPEAT_SIZE;
}

// 在[1, upperBound]查找满足单调条件的最大值；无可行值返回0。
uint32_t BinarySearch(uint32_t upperBound, const std::function<bool(uint32_t)>& isFeasible)
{
    uint64_t lo = 0, hi = static_cast<uint64_t>(upperBound) + 1;
    while (lo + 1 < hi) {
        const uint64_t mid = lo + (hi - lo) / 2;
        if (isFeasible(static_cast<uint32_t>(mid))) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return static_cast<uint32_t>(lo);
}

SoftmaxTilingKey ComputeSoftmaxTiling(uint32_t rows, uint32_t cols, int ubSizeBytes, uint32_t& numAivBlocks,
                                      uint32_t& ubUsedBytes, SoftmaxTilingData& data)
{
    ubUsedBytes = 0;
    data.rows = rows;
    data.cols = cols;
    if (cols == 1) {
        // 每核至少分到一个256B repeat；总数不足64个FP32时只启动一核。
        numAivBlocks = std::min(numAivBlocks, std::max(1u, rows / UB_REPEAT_ELEMS));
        ubUsedBytes = UB_REPEAT_SIZE; // 显式常量onesLocal，替代Fill的隐式stack buffer。
        return SoftmaxTilingKey::SINGLE_TAIL;
    }
    numAivBlocks = std::min(rows, numAivBlocks);
    data.baseRowsPerCore = rows / numAivBlocks;
    data.extraRows = rows % numAivBlocks;

    // xy原地更新，两份整行即可DB；reducedValueLocal_生命周期为max→sum→倒数。
    const uint64_t alignedCols = CeilAlign(static_cast<uint64_t>(cols), UB_REPEAT_ELEMS);
    const uint64_t rowBytes = alignedCols * sizeof(float);
    constexpr uint32_t fullDbReducedValueLocalBytes = UB_REPEAT_SIZE; // max、sum及倒数顺序复用。
    constexpr uint32_t onesLocalBytes = UB_BLOCK_SIZE;                // 计算分母倒数使用的常量1。
    constexpr uint32_t fullStatsBytes = fullDbReducedValueLocalBytes + onesLocalBytes;
    if (2 * rowBytes + fullStatsBytes <= static_cast<uint64_t>(ubSizeBytes)) {
        const uint32_t tmpBytes = QueryReduceTmpBytes(cols);
        const uint64_t usedBytes = 2 * rowBytes + tmpBytes + fullStatsBytes;
        if (usedBytes <= static_cast<uint64_t>(ubSizeBytes)) {
            data.tileCols = cols;
            data.xyLocalBytes = static_cast<uint32_t>(rowBytes);
            data.reduceTmpBytes = tmpBytes;
            data.tmpLocalBytes = tmpBytes;
            ubUsedBytes = static_cast<uint32_t>(usedBytes);
            return SoftmaxTilingKey::FULLLOAD_WITH_DB;
        }
    }

    // 整行无DB：单份xy，reducedValueLocal_顺序复用，WholeReduce分级归约后由Scalar取值。
    constexpr uint32_t fullReducedValueLocalBytes = UB_BLOCK_SIZE; // max/sum顺序复用同一32B。
    const uint64_t repeats = alignedCols / UB_REPEAT_ELEMS;
    const uint64_t scalarTmpBytes = CeilAlign(repeats * 2 * sizeof(float), UB_BLOCK_SIZE);
    const uint64_t scalarUsedBytes = rowBytes + scalarTmpBytes + fullReducedValueLocalBytes;
    if (scalarUsedBytes <= static_cast<uint64_t>(ubSizeBytes)) {
        data.tileCols = cols;
        data.xyLocalBytes = static_cast<uint32_t>(rowBytes);
        data.reduceTmpBytes = static_cast<uint32_t>(scalarTmpBytes);
        data.tmpLocalBytes = static_cast<uint32_t>(scalarTmpBytes);
        ubUsedBytes = static_cast<uint32_t>(scalarUsedBytes);
        return SoftmaxTilingKey::FULLLOAD;
    }

    // GENERAL：xy两份；行状态m/s/ones各一个32B block，m和s同时存活不能重叠。
    constexpr uint32_t rowStatsBytes = 3 * UB_BLOCK_SIZE;
    // 二分搜索单份xy tile能容纳的最大完整repeat数，不是元素数或字节数。
    // 用UB字节数的数值作宽松的repeat数上界；实际容量由lambda判断。
    const uint32_t maxTileRepeats = BinarySearch(ubSizeBytes, [ubSizeBytes, rowStatsBytes](uint32_t tileRepeatCount) {
        const uint32_t tileTmpBytes = QueryReduceTmpBytes(tileRepeatCount * UB_REPEAT_ELEMS) + UB_REPEAT_SIZE;
        // 每repeat是256B；系数2是xy的ping/pong两份buffer。
        const uint32_t xyDoubleBufferBytes = 2 * tileRepeatCount * UB_REPEAT_SIZE;
        // tmp含归约工作区及256B结果区；所有容量均以字节计。
        const uint32_t requiredUbBytes = xyDoubleBufferBytes + tileTmpBytes + rowStatsBytes;
        return requiredUbBytes <= static_cast<uint32_t>(ubSizeBytes);
    });
    if (maxTileRepeats == 0) {
        throw std::runtime_error("UB无法容纳一个softmax repeat及归约空间");
    }
    // 按最大可用repeat数换算tile列数，最多取整行的cols。
    data.tileCols = std::min(cols, maxTileRepeats * UB_REPEAT_ELEMS);
    data.xyLocalBytes = CeilAlign(data.tileCols * sizeof(float), UB_REPEAT_SIZE);
    data.tmpLocalBytes = QueryGeneralTmpBytes(data.tileCols, data.reduceTmpBytes);
    ubUsedBytes = 2 * data.xyLocalBytes + data.tmpLocalBytes + rowStatsBytes;
    return SoftmaxTilingKey::GENERAL;
}

/* ======================== 以上是算子的 Kernel&Tiling 实现  ======================== */

void CheckAcl(aclError error)
{
    if (error != ACL_SUCCESS) {
        throw std::runtime_error("ACL error " + std::to_string(error));
    }
}

// 唯一的流程辅助函数：两次调用同样的 Python 启动与等待过程。
int RunPython(const std::filesystem::path& script, const std::filesystem::path& directory, uint32_t rows, uint32_t cols)
{
    std::string file = script.string(), folder = directory.string();
    std::string rowText = std::to_string(rows), colText = std::to_string(cols);
    char python[] = "python3";
    char* args[]{python, file.data(), folder.data(), rowText.data(), colText.data(), nullptr};
    pid_t pid;
    if (posix_spawnp(&pid, python, nullptr, nullptr, args, environ)) {
        return 1;
    }
    int status = 0;
    while (waitpid(pid, &status, 0) < 0) {
        if (errno != EINTR) {
            return 1;
        }
    }
    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;
}

struct StartupArgs {
    uint32_t rows{DEFAULT_ROWS};
    uint32_t cols{DEFAULT_COLS};
    uint32_t coreNum{0}; // 未传--core-num时，使用查询到的AIV核数。
};

StartupArgs ParseArgs(int argc, char** argv)
{
    const auto printUsage = [&] {
        std::fprintf(stderr,
                     "用法：%s [--shape rows cols] [--core-num n]\n"
                     "默认 shape=%u×%u；未传 --core-num 时使用平台 AIV 核数；行列数必须为正整数。\n",
                     argv[0], DEFAULT_ROWS, DEFAULT_COLS);
    };
    StartupArgs args;
    try {
        auto readPositive = [&](int& i) -> uint32_t {
            if (i == argc) {
                throw std::runtime_error("参数缺少值");
            }
            const std::string text = argv[i++];
            size_t end = 0;
            const uint64_t value = std::stoull(text, &end);
            if (text.empty() || text[0] == '-' || end != text.size() || !value || value > UINT32_MAX) {
                throw std::runtime_error("参数需要正 uint32 整数");
            }
            return value;
        };
        for (int i = 1; i < argc;) {
            const std::string name = argv[i++];
            if (name == "--help" || name == "-h") {
                printUsage();
                std::exit(0);
            }
            if (name == "--core-num") {
                args.coreNum = readPositive(i);
            } else if (name == "--shape") {
                args.rows = readPositive(i);
                args.cols = readPositive(i);
            } else {
                throw std::runtime_error("只支持 --core-num 和 --shape");
            }
        }
        if (!args.rows || !args.cols) {
            throw std::runtime_error("shape 行列数必须为正整数");
        }
        return args;
    } catch (...) {
        printUsage();
        throw;
    }
}

int main(int argc, char** argv)
{
    std::setvbuf(stdout, nullptr, _IOLBF, 0);
    bool initialized = false, deviceSet = false;
    aclrtStream stream = nullptr;
    float* xGmAddr = nullptr;
    float* yGmAddr = nullptr;
    int result = 1;
    try {
        const auto args = ParseArgs(argc, argv);
        const auto appDir = std::filesystem::read_symlink("/proc/self/exe").parent_path();
        const auto directory = appDir / "data/softmax_membase_v04_1";
        std::filesystem::create_directories(directory);

        // 1. 初始化真实设备，型号由当前环境获取。
        CheckAcl(aclInit(nullptr));
        initialized = true;
        CheckAcl(aclrtSetDevice(0));
        deviceSet = true;
        auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
        if (!platform) {
            throw std::runtime_error("无法获取平台信息");
        }
        const uint32_t aivCoreNum = platform->GetCoreNumAiv();
        // 平台接口要求 uint64_t 引用，查询后转为 host 计算 tiling 使用的 int。
        uint64_t platformUbSize = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, platformUbSize);
        if (!platformUbSize || platformUbSize > INT_MAX) {
            throw std::runtime_error("UB 大小无效");
        }
        const int ubSizeBytes = static_cast<int>(platformUbSize);
        std::printf("========== Softmax v04_1 ==========\n");
        std::printf("[Platform]   soc=%s, aivCores=%u, ubSizeBytes=%d\n", aclrtGetSocName(), aivCoreNum, ubSizeBytes);
        if (!aivCoreNum) {
            throw std::runtime_error("平台 AIV 核数无效");
        }
        const uint32_t coreNum = args.coreNum ? args.coreNum : aivCoreNum;
        if (coreNum > aivCoreNum) {
            throw std::runtime_error("--core-num 超过物理 AIV 核数");
        }
        uint32_t numAivBlocks = coreNum; // tiling通过引用回写实际启动核数。
        SoftmaxTilingData data{};
        uint32_t ubUsedBytes = 0; // 仅用于host日志，不传入kernel。
        const auto tilingKey = ComputeSoftmaxTiling(args.rows, args.cols, ubSizeBytes, numAivBlocks, ubUsedBytes, data);
        constexpr const char* tilingKeyNames[]{"SINGLE_TAIL", "FULLLOAD_WITH_DB", "FULLLOAD", "GENERAL"};
        std::printf("[Launch]     shape=(%u,%u), dtype=fp32, blocks=%u\n"
                    "[Launch]     tilingKey=%u(%s)\n",
                    args.rows, args.cols, numAivBlocks, static_cast<uint32_t>(tilingKey),
                    tilingKeyNames[static_cast<uint32_t>(tilingKey)]);
        PrintTilingData(data);
        std::printf(
            "[UB]         bufferNum=%u, usedBytes=%u\n",
            tilingKey == SoftmaxTilingKey::SINGLE_TAIL ? 0u : (tilingKey == SoftmaxTilingKey::FULLLOAD ? 1u : 2u),
            ubUsedBytes);
        CheckAcl(aclrtCreateStream(&stream));

        // 2. Python 生成数据，host 只负责读取 raw FP32。
        if (RunPython(appDir / "softmax_gen.py", directory, args.rows, args.cols)) {
            throw std::runtime_error("gen 失败");
        }
        const size_t bytes = static_cast<size_t>(args.rows) * args.cols * sizeof(float);
        std::vector<float> input(static_cast<size_t>(args.rows) * args.cols), output(input.size());
        std::ifstream file(directory / "input.bin", std::ios::binary);
        if (!file.read(reinterpret_cast<char*>(input.data()), bytes)) {
            throw std::runtime_error("读取输入失败");
        }

        // 3. H2D -> 单次 launch -> stream 同步 -> D2H。
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&xGmAddr), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&yGmAddr), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CheckAcl(aclrtMemcpy(xGmAddr, bytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        if (tilingKey == SoftmaxTilingKey::SINGLE_TAIL) {
            softmax_k<SoftmaxTilingKey::SINGLE_TAIL><<<numAivBlocks, 0, stream>>>(xGmAddr, yGmAddr, data);
        } else if (tilingKey == SoftmaxTilingKey::FULLLOAD_WITH_DB) {
            softmax_k<SoftmaxTilingKey::FULLLOAD_WITH_DB><<<numAivBlocks, 0, stream>>>(xGmAddr, yGmAddr, data);
        } else if (tilingKey == SoftmaxTilingKey::FULLLOAD) {
            softmax_k<SoftmaxTilingKey::FULLLOAD><<<numAivBlocks, 0, stream>>>(xGmAddr, yGmAddr, data);
        } else {
            softmax_k<SoftmaxTilingKey::GENERAL><<<numAivBlocks, 0, stream>>>(xGmAddr, yGmAddr, data);
        }
        CheckAcl(aclrtSynchronizeStream(stream)); // launch 异步，等 kernel 完成后再回读。
        CheckAcl(aclrtMemcpy(output.data(), bytes, yGmAddr, bytes, ACL_MEMCPY_DEVICE_TO_HOST));

        std::ofstream outputFile(directory / "output.bin", std::ios::binary);
        if (!outputFile.write(reinterpret_cast<const char*>(output.data()), bytes)) {
            throw std::runtime_error("保存输出失败");
        }
        outputFile.close();

        // 4. 独立 Python Golden 校验，退出码即样例结果。
        result = RunPython(appDir / "softmax_verify.py", directory, args.rows, args.cols);
    } catch (const std::exception& error) {
        std::fprintf(stderr, "[ERROR]      softmax_membase_v04_1: %s\n", error.what());
    }
    // 5. 成功与失败都显式清理已创建的资源。
    if (stream) {
        aclrtSynchronizeStream(stream);
    }
    if (yGmAddr) {
        aclrtFree(yGmAddr);
    }
    if (xGmAddr) {
        aclrtFree(xGmAddr);
    }
    if (stream) {
        aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        aclrtResetDevice(0);
    }
    if (initialized) {
        aclFinalize();
    }
    return result;
}
